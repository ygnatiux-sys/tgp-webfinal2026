// src/components/Navbar.astro
---

<!-- FIXED NAVBAR -->
<nav class="fixed top-0 left-0 w-full z-50 border-b border-border/20 bg-bg/80 backdrop-blur-md px-6 py-5 flex justify-between items-center transition-all duration-500">
    <div class="flex items-center gap-4 group cursor-pointer">
        <a href="/home" class="flex items-center gap-3">
            <img src="/puzzle.png" alt="Logo" class="h-8 w-auto rounded-sm object-contain group-hover:scale-105 transition-all duration-700" />
            <div class="font-gloock tracking-[0.15em] text-lg md:text-xl lg:text-2xl uppercase titulo-estilo-apple">THE GREAT PUZZLE PROJECT</div>
        </a>
    </div>
    <div class="hidden lg:flex items-center gap-5 xl:gap-7 text-[10px] uppercase tracking-ultra-wide font-light text-primary/80">
        <a href="/home" class="hover:text-vault-accent transition-all duration-500 hover:tracking-[0.35em] text-highlight/90 font-medium">Home</a>
        <a href="/historia-alternativa" class="hover:text-vault-accent transition-all duration-500 hover:tracking-[0.35em] text-vault-accent/90 font-medium">Historia Alternativa</a>
        <a href="/archivo" class="hover:text-vault-loading transition-all duration-500 hover:tracking-[0.35em]">Archivo</a>
        <a href="/series" class="hover:text-vault-loading transition-all duration-500 hover:tracking-[0.35em] text-terracota-light">Series</a>
        <a href="/tesis-home" class="hover:text-vault-loading transition-all duration-500 hover:tracking-[0.35em]">Tesis</a>
        <a href="/media-home" class="hover:text-vault-loading transition-all duration-500 hover:tracking-[0.35em]">Media Lab</a>
        <a href="/tgp-vault" class="text-vault-accent hover:text-highlight transition-all duration-500 hover:tracking-[0.35em] flex items-center gap-1.5 border border-vault-accent/40 px-3.5 py-1.5 rounded-full hover:border-vault-accent hover:bg-vault-accent/10 shadow-[0_0_15px_rgba(201,169,110,0.12)]">
            <span class="text-[9px]">◈</span> Vault
        </a>
        <a href="/about" class="hover:text-vault-loading transition-all duration-500 hover:tracking-[0.35em] text-primary/60">Xavier</a>
    </div>
