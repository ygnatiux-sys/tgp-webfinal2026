---
// src/components/PageHeader.astro
// Encabezado editorial cinematográfico unificado (MUBI × Apple TV+ × A24)

interface Action {
  href: string;
  label: string;
  icon?: string;
}

interface Props {
  kicker?: string;
  title: string;
  accent?: string;
  logline?: string;
  primaryAction?: Action;
  secondaryAction?: Action;
  class?: string;
}

const {
  kicker,
  title,
  accent,
  logline,
  primaryAction,
  secondaryAction,
  class: className = ''
} = Astro.props;
---

<header class={`relative px-6 md:px-16 max-w-7xl mx-auto text-center mb-16 sm:mb-20 ${className}`}>
  <!-- 1. Telemetría superior MUBI / A24 (sin cápsulas ni badges) -->
  {kicker && (
    <div class="flex items-center justify-center gap-2 t-telemetry mb-4">
      <span class="text-vault-accent font-semibold">◈</span>
      <span>{kicker}</span>
    </div>
  )}

  <!-- 2. Título monumental Bodoni Extra Bold -->
  <h1 class="t-display text-5xl sm:text-7xl md:text-8xl lg:text-9xl mb-6 select-none">
    {title} {accent && <span class="italic font-light text-vault-accent">{accent}</span>}
  </h1>

  <!-- 3. Divisor sutil -->
  <div class="w-20 h-px bg-white/20 mx-auto mb-6"></div>

  <!-- 4. Logline de autor en Bodoni itálica -->
  {logline && (
    <p class="t-logline text-base sm:text-lg md:text-xl max-w-2xl mx-auto mb-8">
      {logline}
    </p>
  )}

  <!-- 5. Acciones editoriales en cristal Apple Glass -->
  {(primaryAction || secondaryAction) && (
    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
      {primaryAction && (
        <a href={primaryAction.href} class="btn-glass">
          <span>{primaryAction.label}</span>
          <span class="text-sm transition-transform duration-300 group-hover:translate-x-1">
            {primaryAction.icon || '→'}
          </span>
        </a>
      )}

      {secondaryAction && (
        <a href={secondaryAction.href} class="btn-ghost">
          <span>{secondaryAction.label}</span>
          {secondaryAction.icon && <span class="text-xs text-vault-accent">{secondaryAction.icon}</span>}
        </a>
      )}
    </div>
  )}

  <slot />
</header>
