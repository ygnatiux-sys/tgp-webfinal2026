---

<footer class="relative bg-bg border-t border-border py-16 px-6 md:px-16 overflow-hidden">
	<!-- Soft ambient glow in footer background -->
	<div class="footer-glow absolute bottom-0 left-1/2 -translate-x-1/2 opacity-30 pointer-events-none"></div>
	
	<div class="max-w-7xl mx-auto relative z-10 space-y-12">
		<!-- Top Row: Branding & Navigation -->
		<div class="flex flex-col md:flex-row justify-between items-center gap-8">
			<div class="flex items-center gap-4 group cursor-pointer">
				<img src="/puzzle.png" alt="Logo" class="w-8 h-auto rounded-sm object-contain group-hover:scale-105 transition-all duration-700" />
				<div class="font-gloock text-xl tracking-[0.15em] uppercase titulo-estilo-apple">THE GREAT PUZZLE PROJECT</div>
			</div>
			
			<div class="flex flex-wrap gap-8 text-[10px] uppercase tracking-ultra-wide font-light text-primary/60">
				<a href="/proyectos" class="footer-link hover:text-vault-loading transition-all duration-500 hover:tracking-[0.4em]">Proyectos</a>
				<a href="/tesis-home" class="footer-link hover:text-vault-loading transition-all duration-500 hover:tracking-[0.4em]">Tesis</a>
				<a href="/media-home" class="footer-link hover:text-vault-loading transition-all duration-500 hover:tracking-[0.4em]">Media Lab</a>
				<a href="/archivo" class="footer-link hover:text-vault-loading transition-all duration-500 hover:tracking-[0.4em]">Archivo</a>
			</div>
		</div>

		<!-- Divider -->
		<div class="w-full h-px bg-border/20"></div>

		<!-- Bottom Row: Socials, Location, Copyright -->
		<div class="flex flex-col md:flex-row justify-between items-center gap-8">
			<!-- Copyright -->
			<div class="text-[9px] uppercase tracking-[0.3em] text-primary/40 order-3 md:order-1">
				<a href="https://gravatar.com/xavierbeniteztgp" target="_blank" class="hover:text-vault-loading hover:opacity-100 transition-all duration-500">Xavier Benítez <a href="https://alternative.thegreatpuzzleproject.com/" target="_blank" rel="noopener noreferrer" style="color:inherit;text-decoration:none;cursor:default;pointer-events:auto;">©</a> 2026</a>
			</div>

			<!-- Centered Socials -->
			<div class="flex items-center gap-3 order-1 md:order-2">
				<!-- X -->
				<a href="https://x.com/TheTGPProject" target="_blank" class="social-icon group" aria-label="X (Twitter)">
					<svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
				</a>
				<!-- Instagram -->
				<a href="https://instagram.com/thegreatpuzzleproject" target="_blank" class="social-icon group" aria-label="Instagram">
