			</div>

			<!-- Location & Sur Global -->
			<div class="text-[9px] uppercase tracking-[0.3em] text-primary/40 text-center md:text-right flex items-center gap-3 order-2 md:order-3">
				<a href="https://share.google/t7kBxRQ1x48w3k9Em" target="_blank" class="hover:text-vault-loading transition-all duration-500 flex items-center gap-1.5">
					<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="opacity-60"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
					<span>Buenos Aires</span>
				</a>
				<span class="text-vault-loading font-bold">SUR GLOBAL</span>
			</div>
		</div>
	</div>
</footer>

<style>
	.footer-glow {
		width: 400px;
		height: 150px;
		background: radial-gradient(circle, rgba(159, 140, 174, 0.12) 0%, transparent 80%);
		filter: blur(40px);
	}
	
	/* Soft lantern glow for footer link select/hover */
	.footer-link {
		position: relative;
		transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.footer-link:hover {
		color: #9F8CAE;
		text-shadow: 
			0 0 8px rgba(159, 140, 174, 0.6),
			0 0 20px rgba(159, 140, 174, 0.2);
	}

	/* Soft glow and transitions for social icons */
	.social-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		border: 1px solid rgba(255, 255, 255, 0.08);
		color: rgba(255, 255, 255, 0.4);
		transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
		background-color: transparent;
	}

	.social-icon:hover {
		color: #9F8CAE;
		border-color: rgba(159, 140, 174, 0.4);
		background-color: rgba(159, 140, 174, 0.04);
		box-shadow: 
			0 0 12px rgba(159, 140, 174, 0.25),
			inset 0 0 8px rgba(159, 140, 174, 0.1);
		transform: translateY(-2px);
	}
</style>
