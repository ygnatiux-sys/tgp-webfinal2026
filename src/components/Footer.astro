				</a>
				<!-- Spotify -->
				<a href="https://open.spotify.com/show/3zFq9ab980MamMHW48Sqxy?si=e2a490cc5ce94f2b" target="_blank" class="social-icon group" aria-label="Spotify">
					<svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm5.59 17.318c-.22.362-.689.47-1.05.249-2.83-1.728-6.391-2.121-10.589-1.161-.413.095-.823-.164-.917-.577s.164-.822.577-.917c4.591-1.05 8.528-.598 11.73 1.356.36.219.472.689.249 1.05zm1.488-3.262c-.277.449-.863.591-1.311.313-3.238-1.99-8.175-2.565-11.999-1.404-.509.155-1.04-.132-1.196-.64s.131-1.042.64-1.197c4.372-1.328 9.807-.68 13.555 1.624.448.277.59.862.311 1.304zm.131-3.418c-3.882-2.305-10.287-2.518-14.015-1.386-.595.18-1.23-.158-1.411-.753-.18-.594.158-1.23.753-1.41 4.288-1.302 11.353-1.055 15.82 1.597.535.318.708 1.008.39 1.543s-1.008.709-1.537.409z"/></svg>
				</a>
				<!-- Email -->
				<a href="mailto:ygnatiux@gmail.com" class="social-icon group" aria-label="Email">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
