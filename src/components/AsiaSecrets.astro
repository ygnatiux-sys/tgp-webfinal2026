---
// src/components/AsiaSecrets.astro
// Componente cinemático con tambor 3D rotativo (5 caras).
// Óptica forzada para simular curvatura cilíndrica.

import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  accent?: string;
  kicker?: string;
  limit?: number;
}

const {
  title = "ASIA",
  accent = "SECRETS",
  kicker = "A Cinematic Journey",
  limit = 5 // Forzamos 5 tarjetas para armar el pentágono 3D
} = Astro.props;

// 1. Extracción de ensayos
let alternativePosts: any[] = [];

try {
  const ensayos = await getCollection('ensayos', ({ data }) => !data.draft);
  if (Array.isArray(ensayos) && ensayos.length > 0) {
    alternativePosts = ensayos
      .map(e => ({
        id: e.id,
        slug: e.id,
        title: e.data.title || 'Ensayo Histórico',
        category: e.data.category || e.data.volanta || 'Historia Alternativa',
        url: `/ensayos/${e.id}`,
        imageUrl: e.data.coverImage || e.data.heroUrl || (e.data.gallery && e.data.gallery.length > 0 ? e.data.gallery[0] : null)
      }))
      .filter(item => Boolean(item.imageUrl));
  }
} catch (err) {
  console.warn('[AsiaSecrets] Error leyendo colección:', err);
}

// Fallbacks de alta resolución (se necesitan 5 mínimo para el efecto pentagonal)
const fallbackCards = [
  {
    id: 'asia-neon',
    title: 'Tokio Anómalo & la Ciudad de Silicio',
    category: 'Estratigrafía Urbana',
    url: '/ensayos/tokio-anomalo',
    imageUrl: 'https://images.unsplash.com/photo-1503899036084-c55cdd92da26?auto=format&fit=crop&w=800&q=80'
  },
  {
    id: 'asia-temple',
    title: 'Santuarios de Altura en el Karst de Asia',
    category: 'Arquitectura Sagrada',
    url: '/ensayos/santuarios-karst',
    imageUrl: 'https://images.unsplash.com/photo-1528164344705-475426879c0d?auto=format&fit=crop&w=800&q=80'
  },
  {
    id: 'asia-roofs',
    title: 'Pagodas de Tejas Ancestrales',
    category: 'Arqueología de las Formas',
    url: '/ensayos/pagodas-ancestrales',
    imageUrl: 'https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?auto=format&fit=crop&w=800&q=80'
  },
  {
    id: 'derinkuyu',
    title: 'Derinkuyu Subterránea: La Geometría Ctoniana',
    category: 'Arqueología Subterránea',
    url: '/ensayos/derinkuyu',
    imageUrl: 'https://storage.thegreatpuzzleproject.com/vault-media/1792137342460-4f977b70.webp'
  },
  {
    id: 'masuda',
    title: 'Masuda no Iwafune: La Nave de Roca en Asuka',
    category: 'Anomalías Líticas',
    url: '/ensayos/masuda-no-iwafune',
    imageUrl: 'https://storage.thegreatpuzzleproject.com/vault-media/1792133914689-44dd5943.webp'
  }
];

const validPosts = alternativePosts.length >= 5 ? alternativePosts : fallbackCards;
const cardsToDisplay = validPosts.slice(0, limit > 0 ? limit : 5);

const totalCards = cardsToDisplay.length;
const angleStep = 360 / totalCards;

// Radio dinámico ajustado para 5 cartas (pentágono)
const cardWidth = 280;
// Achicamos ligeramente el margen extra para que la curva se sienta más cerrada
const dynamicRadius = Math.max(300, Math.round((cardWidth / 2) / Math.tan(Math.PI / totalCards)) + 25);
---

<section 
  id="asia-secrets-section" 
  class="relative w-full min-h-[92vh] lg:min-h-screen bg-[#050508] overflow-hidden flex flex-col lg:flex-row items-center justify-between px-6 sm:px-12 md:px-20 py-24 lg:py-0 select-none border-t border-b border-white/5 my-12"
>
  <!-- Glow Ambiental Multicapa -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[85vw] h-[85vh] bg-purple-900/12 blur-[140px] rounded-full"></div>
    <div class="absolute top-1/3 left-1/4 w-[45vw] h-[45vh] bg-fuchsia-800/10 blur-[110px] rounded-full"></div>
    <div class="absolute inset-0 bg-radial from-transparent via-[#050508]/60 to-[#050508]"></div>
  </div>

  <!-- Sector Izquierdo: Tipografía -->
  <div class="relative z-10 flex flex-col justify-center w-full lg:w-1/2 max-w-2xl mb-16 lg:mb-0">
    <span class="text-white/45 text-xs tracking-[0.35em] uppercase font-mono mb-6 flex items-center gap-3">
      <span class="inline-block w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
      {kicker}
    </span>
    
    <div class="relative inline-block mb-4">
      <h1 class="text-7xl sm:text-8xl md:text-9xl lg:text-[10rem] font-serif font-bold leading-none tracking-tight text-transparent bg-clip-text bg-gradient-to-b from-white via-white to-purple-400 drop-shadow-[0_0_20px_rgba(186,104,200,0.35)]">
        {title}
      </h1>
      <h2 class="absolute -bottom-5 sm:-bottom-7 md:-bottom-8 left-6 sm:left-12 text-4xl sm:text-6xl md:text-7xl font-sans font-bold text-[#e0b3ff] tracking-[0.3em] drop-shadow-[0_0_25px_rgba(212,148,255,0.7)] pointer-events-none">
        {accent}
      </h2>
    </div>

    <!-- Metadatos dinámicos -->
    <div class="mt-12 pt-4 border-t border-white/10 max-w-lg space-y-3">
      <div id="drum-active-badge" class="text-[11px] font-mono uppercase tracking-[0.28em] text-purple-300">
        {cardsToDisplay[0].category}
      </div>
      <h3 id="drum-active-title" class="font-serif text-2xl sm:text-3xl text-white font-medium line-clamp-2 leading-snug">
        {cardsToDisplay[0].title}
      </h3>
      <div class="pt-2 flex items-center gap-6">
        <a 
          id="drum-active-link" 
          href={cardsToDisplay[0].url}
          class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.25em] text-[#e0b3ff] hover:text-white font-semibold transition-colors duration-300 group/link"
        >
          <span>Explorar Ensayo</span>
          <span class="transition-transform duration-300 group-hover/link:translate-x-1">→</span>
        </a>

        <div class="flex items-center gap-2">
          <button id="drum-prev-btn" class="w-8 h-8 rounded-full border border-white/15 bg-white/5 hover:bg-white/15 flex items-center justify-center text-white/70 hover:text-white transition-all text-xs cursor-pointer" aria-label="Anterior">←</button>
          <button id="drum-next-btn" class="w-8 h-8 rounded-full border border-white/15 bg-white/5 hover:bg-white/15 flex items-center justify-center text-white/70 hover:text-white transition-all text-xs cursor-pointer" aria-label="Siguiente">→</button>
        </div>
      </div>
    </div>

    <!-- Indicador -->
    <div class="flex items-center gap-8 mt-12 text-white/40 text-xs tracking-[0.3em] uppercase font-mono">
      <span>{kicker}</span>
      <span id="drum-counter-indicator">01 / {String(totalCards).padStart(2, '0')} · Chapter</span>
    </div>
  </div>

  <!-- Sector Derecho: Tambor 3D con Óptica Curva -->
  <div class="relative z-10 w-full lg:w-1/2 h-[480px] sm:h-[560px] md:h-[620px] flex items-center justify-center drum-viewport">
    
    <div class="drum-scene relative w-[280px] h-[420px] transform-style-preserve-3d cursor-grab active:cursor-grabbing" style="transform: rotateX(-8deg) rotateZ(-3deg) rotateY(-10deg);">
      
      <div class="drum-container relative w-full h-full transform-style-preserve-3d">
        {cardsToDisplay.map((post, i) => {
          const rotationAngle = i * angleStep;
          
          return (
            <div 
              class="card-wrapper absolute inset-0 transform-style-preserve-3d" 
              style={`transform: rotateY(${rotationAngle}deg) translateZ(${dynamicRadius}px);`}
              data-index={i}
              data-title={post.title}
              data-category={post.category}
              data-url={post.url}
            >
              <a 
                href={post.url}
                class="drum-card block relative w-full h-full rounded-[2rem] border border-white/20 bg-black overflow-hidden group transition-all duration-500"
              >
                <!-- Sombra interior óptica para simular curvatura cilíndrica -->
                <div class="absolute inset-0 z-20 shadow-[inset_28px_0_35px_rgba(0,0,0,0.7),inset_-28px_0_35px_rgba(0,0,0,0.7)] pointer-events-none transition-opacity duration-500 opacity-80 group-hover:opacity-40"></div>
                
                <!-- Reflejo cilíndrico de bisel para acentuar el doblez en el horizonte -->
                <div class="card-curve-lens absolute inset-0 z-20 pointer-events-none bg-gradient-to-r from-black/40 via-white/5 to-black/50 mix-blend-overlay"></div>

                <img 
                  src={post.imageUrl} 
                  alt={post.title} 
                  class="w-full h-full object-cover opacity-90 transition-transform duration-1000 group-hover:scale-105" 
                  loading={i < 3 ? "eager" : "lazy"}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/35 via-55% to-transparent pointer-events-none z-10"></div>
                <div class="absolute inset-0 ring-1 ring-inset ring-white/15 rounded-[2rem] pointer-events-none z-30"></div>

                <div class="absolute bottom-6 left-6 right-6 z-30 pointer-events-none">
                  <span class="text-[10px] tracking-[0.25em] uppercase text-purple-300 font-mono block mb-1">
                    {post.category}
                  </span>
                  <h4 class="font-serif text-base font-bold text-white line-clamp-2 leading-tight drop-shadow-md">
                    {post.title}
                  </h4>
                </div>
              </a>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style>
  /* Distorsión focal agresiva: de 1500px a 850px para pronunciar la curvatura */
  .drum-viewport { perspective: 850px; -webkit-perspective: 850px; }
  .transform-style-preserve-3d { transform-style: preserve-3d; -webkit-transform-style: preserve-3d; }
  .card-wrapper { backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .drum-card { will-change: transform, opacity, filter; }

  .drum-card.is-active {
    border-color: rgba(224, 179, 255, 0.75);
    box-shadow: 0 0 35px rgba(212, 148, 255, 0.45), 0 0 70px rgba(186, 104, 200, 0.25), inset 0 0 15px rgba(212, 148, 255, 0.3);
  }
</style>

<script>
  import { gsap } from "gsap";

  function setupAsiaSecretsDrum() {
    const section = document.getElementById('asia-secrets-section');
    if (!section) return;

    const container = section.querySelector('.drum-container');
    const cards = gsap.utils.toArray('.drum-card', section) as HTMLElement[];
    const wrappers = gsap.utils.toArray('.card-wrapper', section) as HTMLElement[];
    const totalCards = cards.length;

    if (!container || totalCards === 0) return;

    const angleStep = 360 / totalCards;
    let currentIndex = 0;
    let isPaused = false;
    let autoTimer: any = null;

    const activeBadge = document.getElementById('drum-active-badge');
    const activeTitle = document.getElementById('drum-active-title');
    const activeLink = document.getElementById('drum-active-link');
    const counterIndicator = document.getElementById('drum-counter-indicator');
    const prevBtn = document.getElementById('drum-prev-btn');
    const nextBtn = document.getElementById('drum-next-btn');

    cards.forEach((card, i) => {
      if (i === 0) {
        card.classList.add('is-active');
        gsap.set(card, { opacity: 1, filter: "brightness(1) blur(0px)" });
      } else {
        const diff = Math.min(Math.abs(i - 0), totalCards - Math.abs(i - 0));
        // Para 5 tarjetas: la adyacente es diff 1, la posterior es diff 2.
        const isNeighbor = diff === 1;
        card.classList.remove('is-active');
        gsap.set(card, {
          opacity: isNeighbor ? 0.35 : 0.05,
          filter: isNeighbor ? "brightness(0.45) blur(1.5px)" : "brightness(0.2) blur(4px)"
        });
      }
    });

    function updateActiveInfo(index: number) {
      const activeIndex = ((index % totalCards) + totalCards) % totalCards;
      const activeWrapper = wrappers[activeIndex];

      if (activeWrapper) {
        if (activeBadge) activeBadge.textContent = activeWrapper.getAttribute('data-category') || '';
        if (activeTitle) activeTitle.textContent = activeWrapper.getAttribute('data-title') || '';
        if (activeLink) activeLink.setAttribute('href', activeWrapper.getAttribute('data-url') || '#');
        if (counterIndicator) {
          counterIndicator.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(totalCards).padStart(2, '0')} · Chapter`;
        }
      }

      cards.forEach((card, i) => {
        const isFront = i === activeIndex;
        const diff = Math.min(Math.abs(i - activeIndex), totalCards - Math.abs(i - activeIndex));
        const isNeighbor = diff === 1;

        if (isFront) card.classList.add('is-active');
        else card.classList.remove('is-active');

        gsap.to(card, {
          opacity: isFront ? 1 : (isNeighbor ? 0.35 : 0.05),
          filter: isFront ? "brightness(1) blur(0px)" : (isNeighbor ? "brightness(0.45) blur(1.5px)" : "brightness(0.2) blur(4px)"),
          duration: 1.2,
          ease: "power2.inOut",
          delay: isFront ? 0.15 : 0
        });
      });
    }

    function rotateDrum(targetStep?: number) {
      if (typeof targetStep === 'number') currentIndex = targetStep;
      else currentIndex++;

      const targetRotationY = currentIndex * -angleStep;

      gsap.to(container, {
        rotationY: targetRotationY,
        duration: 1.4,
        ease: "power3.inOut"
      });

      updateActiveInfo(currentIndex);
    }

    function startTimer() {
      stopTimer();
      autoTimer = setInterval(() => {
        if (!isPaused) rotateDrum();
      }, 3500);
    }

    function stopTimer() {
      if (autoTimer) {
        clearInterval(autoTimer);
        autoTimer = null;
      }
    }

    startTimer();

    const drumScene = section.querySelector('.drum-scene');
    if (drumScene) {
      drumScene.addEventListener('mouseenter', () => { isPaused = true; });
      drumScene.addEventListener('mouseleave', () => { isPaused = false; });
    }

    if (prevBtn) prevBtn.addEventListener('click', (e) => { e.preventDefault(); rotateDrum(currentIndex - 1); });
    if (nextBtn) nextBtn.addEventListener('click', (e) => { e.preventDefault(); rotateDrum(currentIndex + 1); });

    wrappers.forEach((wrapper, i) => {
      wrapper.addEventListener('click', (e) => {
        const activeIndex = ((currentIndex % totalCards) + totalCards) % totalCards;
        if (i !== activeIndex) {
          e.preventDefault();
          let diff = i - activeIndex;
          if (diff > totalCards / 2) diff -= totalCards;
          if (diff < -totalCards / 2) diff += totalCards;
          rotateDrum(currentIndex + diff);
        }
      });
    });
  }

  document.addEventListener("DOMContentLoaded", setupAsiaSecretsDrum);
  document.addEventListener("astro:page-load", setupAsiaSecretsDrum);
</script>
