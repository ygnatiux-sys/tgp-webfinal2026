---
/**
 * AppleBentoArchetypes.astro
 * Visor Cinemático IMAX 2.00:1 (Apple TV Master Style).
 * Presenta las 3 investigaciones arqueológicas del sample en escala IMAX panorámica:
 * - Secuencia 01: El Tel y la Sombra: Belo Brdo (Calcolítico Balcánico · 5.700–4.500 a.C.)
 * - Secuencia 02: El Cataclismo del Younger Dryas (Pleistoceno Tardío · 12.800 AP)
 * - Secuencia 03: Göbekli Tepe: El Templo Pre-Agrícola (Pre-Cerámico A · 9.600 a.C.)
 * 
 * Incorpora:
 * - Visor panorámico IMAX Ultra-Wide con ratio cinematográfico y ambient glow reactivo.
 * - Ciclo secuencial automatizado mediante GSAP Timeline con Dolly Zoom + Stagger editorial.
 * - Selectores de secuencia interactivos con barras de progreso vivas y pausa en hover.
 */

export interface ImaxPostSequence {
  id: string;
  sequenceNumber: string;
  title: string;
  titleAccent: string;
  volanta: string;
  category: string;
  date: string;
  era: string;
  badge: string;
  excerpt: string;
  imageUrl: string;
  ctaLabel: string;
  ctaUrl: string;
  accentColor: string; // ej: '#c9a96e', '#e07a5f', '#d4af37'
}

interface Props {
  badgeLabel?: string;
  sequences?: ImaxPostSequence[];
}

const {
  badgeLabel = "Expediciones Catalogadas · Visor IMAX",
  sequences,
} = Astro.props;

// Trío Oficial de la Muestra (Secuencia Estricta del Sample)
const defaultSequences: ImaxPostSequence[] = [
  // ── SECUENCIA 01: BELO BRDO ──
  {
    id: "seq-belo-brdo",
    sequenceNumber: "01",
    title: "El Tel y la Sombra:",
    titleAccent: "Belo Brdo",
    volanta: "PROTO-ESCRITURA LITÚRGICA · NEOLÍTICO DANUBIANO",
    category: "Proto-Escritura & Neolítico",
    date: "5.700–4.500 a.C.",
    era: "Calcolítico Balcánico",
    badge: "+ PROTO-ESCRITURA LITÚRGICA",
    excerpt: "Diez metros de estratigrafía en las riberas del Danubio revelan la metalurgia de cobre más antigua del mundo y signos sagrados que fracturan la cronología oficial.",
    imageUrl: "/vinca-belo-brdo.jpg",
    ctaLabel: "Ver Dossier Arqueológico",
    ctaUrl: "/ensayos/el-tel-y-la-sombra-belo-brdo",
    accentColor: "#c9a96e"
  },
  // ── SECUENCIA 02: YOUNGER DRYAS ──
  {
    id: "seq-younger-dryas",
    sequenceNumber: "02",
    title: "El Cataclismo del",
    titleAccent: "Younger Dryas",
    volanta: "EVIDENCIA GEOLÓGICA · IMPACTO CÓSMICO",
    category: "Catastrofismo Geológico",
    date: "12.800 AP",
    era: "Pleistoceno Tardío",
    badge: "+ EVIDENCIA GEOLÓGICA",
    excerpt: "Nanodiamantes, esférulas magnéticas y una anomalía global de platino respaldan la hipótesis del impacto cometario que forzó el reinicio civilizatorio.",
    imageUrl: "/magazine-hero-gobekli.jpg",
    ctaLabel: "Explorar Registro Cósmico",
    ctaUrl: "/magazine/gobekli-tepe",
    accentColor: "#e58e4a"
  },
  // ── SECUENCIA 03: GÖBEKLI TEPE ──
  {
    id: "seq-gobekli-tepe",
    sequenceNumber: "03",
    title: "Göbekli Tepe:",
    titleAccent: "El Templo Arcaico",
    volanta: "MEGALITISMO ARCAICO · ARQUEOLOGÍA COGNITIVA",
    category: "Arqueología Cognitiva",
    date: "9.600 a.C.",
    era: "Pre-Cerámico A",
    badge: "+ MEGALITISMO ARCAICO",
    excerpt: "Pilares monolíticos de quince toneladas labrados con iconografía de leopardos y astronomía ritual. La prueba física de que el templo precedió a la agricultura.",
    imageUrl: "https://upload.wikimedia.org/wikipedia/commons/d/d4/G%C3%B6bekli_Tepe_Birthing_Woman_in_Leopard_Pillar_Building.jpg",
    ctaLabel: "Descifrar Templo de Anatolia",
    ctaUrl: "/archivo",
    accentColor: "#d9b35b"
  }
];

const items = sequences && sequences.length > 0 ? sequences : defaultSequences;
---

<section class="w-full px-2 sm:px-4 md:px-8 py-6 md:py-10 bg-transparent">
  <!-- CONTENEDOR VISOR CINEMÁTICO IMAX (Ratio 2.00:1 / Gran Angular) -->
  <div
    id="imax-visor-archetypes"
    class="relative isolate w-full max-w-400 min-h-145 sm:min-h-160 md:min-h-175 lg:min-h-190 mx-auto rounded-[28px] sm:rounded-[36px] overflow-hidden bg-[#07080b] border border-white/15 shadow-[0_35px_100px_rgba(0,0,0,0.95)] select-none group/visor"
  >
    {/* ── 1. FONDOS CINEMÁTICOS DE CADA SECUENCIA (CROSSFADE + DOLLY ZOOM GSAP) ── */}
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
      {items.map((item, idx) => (
        <div
          id={`bg-slide-${idx}`}
          class={`imax-bg-slide absolute inset-0 w-full h-full transition-opacity duration-700 ${idx === 0 ? 'opacity-100' : 'opacity-0'}`}
        >
          <!-- Imagen Principal Panorámica IMAX -->
          <img
            src={item.imageUrl}
            alt={item.title + ' ' + item.titleAccent}
            loading={idx === 0 ? "eager" : "lazy"}
            decoding="async"
            class="imax-slide-img w-full h-full object-cover object-[center_38%] filter brightness-90 contrast-105 will-change-transform"
          />

          <!-- Ambient Glow cálido personalizado según el mineral de la secuencia -->
          <div
            class="absolute inset-0 pointer-events-none"
            style={`background: radial-gradient(circle at 75% 35%, ${item.accentColor}33 0%, rgba(15,18,26,0.5) 45%, rgba(7,8,11,0.92) 80%);`}
          ></div>
        </div>
      ))}

      {/* Degradado lateral para máxima legibilidad tipográfica Apple/IMAX */}
      <div class="absolute inset-0 z-1 bg-[linear-gradient(90deg,#07080b_0%,#07080b_35%,rgba(7,8,11,0.85)_55%,rgba(7,8,11,0.3)_75%,transparent_100%)] pointer-events-none"></div>

      {/* Viñeta perimetral anti-costuras */}
      <div class="absolute inset-0 z-1 bg-[radial-gradient(ellipse_at_center,transparent_55%,rgba(7,8,11,0.85)_100%)] pointer-events-none"></div>

      {/* Degradado base inferior para anclar barra de controles */}
      <div class="absolute inset-x-0 bottom-0 h-44 z-1 bg-linear-to-t from-[#07080b] via-[#07080b]/80 to-transparent pointer-events-none"></div>
    </div>

    {/* ── 2. HEADER SUPERIOR DEL VISOR (ESTILO APPLE TV CINEMATIC) ── */}
    <div class="relative z-20 w-full px-6 sm:px-10 md:px-14 pt-6 sm:pt-8 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="text-white font-extrabold tracking-tight text-lg sm:text-xl font-sans flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
          TGP <span class="font-light text-white/50">IMAX</span>
        </span>
        <span class="text-[10px] sm:text-[11px] uppercase tracking-[0.25em] font-mono px-3 py-1 rounded-full bg-black/60 text-amber-300/90 border border-white/15 backdrop-blur-md">
          {badgeLabel}
        </span>
      </div>

      <!-- Indicador de Secuencia Dinámica -->
      <div class="flex items-center gap-2">
        <span class="text-[10px] font-mono text-white/40 uppercase tracking-widest hidden sm:inline-block">
          Secuencia:
        </span>
        <div id="sequence-counter" class="text-xs font-mono font-bold px-3 py-1 rounded-full bg-white/10 text-white border border-white/15 backdrop-blur-md">
          01 / 03
        </div>
      </div>
    </div>

    {/* ── 3. CONTENIDO PRINCIPAL EDITORIAL (CAMBIOS DE TEXTOS VINCULADOS A CADA SECUENCIA) ── */}
    <div class="relative z-20 w-full px-6 sm:px-10 md:px-14 py-8 md:py-14 flex flex-col justify-center min-h-105 sm:min-h-115 md:min-h-125">
      {items.map((item, idx) => (
        <div
          id={`content-slide-${idx}`}
          class={`imax-content-slide max-w-3xl flex flex-col items-start transition-all duration-500 ${idx === 0 ? 'relative opacity-100 pointer-events-auto' : 'absolute opacity-0 pointer-events-none'}`}
        >
          {/* Fila de Badges Arqueológicos del Sample */}
          <div class="slide-elem flex flex-wrap items-center gap-2.5 mb-4">
            <span
              class="px-3 py-1 rounded-full bg-black/70 backdrop-blur-md border text-[9px] sm:text-[10px] font-mono tracking-widest uppercase font-semibold"
              style={`border-color: ${item.accentColor}66; color: ${item.accentColor};`}
            >
              ✦ {item.badge}
            </span>

            <span class="px-2.5 py-0.5 rounded-full bg-white/10 text-white/90 text-[9px] sm:text-[10px] font-mono uppercase tracking-widest backdrop-blur-md border border-white/10">
              {item.era}
            </span>

            <span class="px-2.5 py-0.5 rounded-full bg-amber-400/10 text-amber-300 text-[9px] sm:text-[10px] font-mono uppercase tracking-widest border border-amber-400/20">
              {item.date}
            </span>
          </div>

          <!-- Volanta / Categoría Editorial -->
          <div class="slide-elem text-[11px] sm:text-xs font-mono tracking-[0.35em] text-white/60 uppercase font-semibold mb-2">
            ◈ {item.volanta}
          </div>

          <!-- Título Monumental Univisium / IMAX -->
          <h2 class="slide-elem font-bodoni font-extrabold text-3xl sm:text-5xl md:text-6xl lg:text-[4vw] text-white leading-[0.96] tracking-tight mb-4 [text-shadow:0_4px_24px_rgba(0,0,0,0.95)]">
            {item.title} <span class="italic font-light" style={`color: ${item.accentColor};`}>{item.titleAccent}</span>
          </h2>

          <!-- Excerpt Exegético -->
          <p class="slide-elem font-outfit text-sm sm:text-base md:text-lg text-white/85 max-w-2xl leading-relaxed mb-6 font-normal drop-shadow-md">
            {item.excerpt}
          </p>

          <!-- Botón de Acción Directa estilo Apple TV Button -->
          <div class="slide-elem flex items-center gap-3">
            <a
              href={item.ctaUrl}
              class="px-7 py-3.5 rounded-full bg-white text-black hover:bg-amber-300 hover:scale-[1.03] active:scale-[0.98] transition-all duration-300 font-sans text-xs sm:text-sm font-bold tracking-tight inline-flex items-center gap-2.5 shadow-[0_10px_30px_rgba(255,255,255,0.2)] group/cta"
            >
              <span>{item.ctaLabel}</span>
              <span class="text-sm transition-transform group-hover/cta:translate-x-1">→</span>
            </a>

            <span class="text-[10px] font-mono text-white/40 uppercase tracking-widest hidden sm:inline-block pl-2">
              Registro Verificado · The Great Puzzle
            </span>
          </div>
        </div>
      ))}
    </div>

    {/* ── 4. CONTROLADOR DE SECUENCIAS INFERIOR (PÍLDORAS CON PROGRESO ACTIVO) ── */}
    <div class="relative z-20 w-full px-6 sm:px-10 md:px-14 pb-6 sm:pb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-t border-white/10 pt-4">
      <!-- Selector de 3 Secuencias con Barra de Progreso Viva -->
      <div class="flex items-center gap-2 sm:gap-3 w-full sm:w-auto">
        {items.map((item, idx) => (
          <button
            type="button"
            data-target-seq={idx}
            class={`seq-tab relative px-3 sm:px-4 py-2 sm:py-2.5 rounded-xl border text-left transition-all duration-300 overflow-hidden cursor-pointer flex-1 sm:flex-initial ${idx === 0 ? 'bg-white/15 border-white/30 text-white' : 'bg-black/40 border-white/10 text-white/50 hover:bg-white/10 hover:text-white'}`}
          >
            <!-- Línea de Progreso de Tiempo de la Secuencia -->
            <div
              id={`seq-progress-${idx}`}
              class="seq-progress-bar absolute bottom-0 left-0 h-0.5 bg-amber-400 transition-all duration-100"
              style={`width: ${idx === 0 ? '0%' : '0%'};`}
            ></div>

            <div class="flex items-center gap-2">
              <span class="text-[10px] font-mono font-bold text-amber-300">
                {item.sequenceNumber}
              </span>
              <span class="text-[11px] sm:text-xs font-sans font-medium tracking-tight truncate max-w-30 sm:max-w-40">
                {item.titleAccent}
              </span>
            </div>
          </button>
        ))}
      </div>

      <!-- Feedback de Pausa en Hover -->
      <div class="text-[10px] font-mono text-white/40 tracking-wider uppercase flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400/80"></span>
        <span>Hover para pausar visor</span>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  interface SequenceManager {
    kill: () => void;
  }

  let activeManager: SequenceManager | null = null;

  function initImaxVisor() {
    const visor = document.getElementById('imax-visor-archetypes');
    if (!visor) return;

    if (activeManager) {
      activeManager.kill();
      activeManager = null;
    }

    const bgSlides = Array.from(visor.querySelectorAll<HTMLElement>('.imax-bg-slide'));
    const contentSlides = Array.from(visor.querySelectorAll<HTMLElement>('.imax-content-slide'));
    const tabs = Array.from(visor.querySelectorAll<HTMLButtonElement>('.seq-tab'));
    const progressBars = Array.from(visor.querySelectorAll<HTMLElement>('.seq-progress-bar'));
    const counter = document.getElementById('sequence-counter');

    if (bgSlides.length === 0 || contentSlides.length === 0) return;

    let currentIndex = 0;
    const total = bgSlides.length;
    const SEQUENCE_DURATION = 6; // segundos por secuencia en el visor
    let tweenProgress: gsap.core.Tween | null = null;
    let sequenceTimer: ReturnType<typeof setTimeout> | null = null;
    let isPaused = false;

    function updateActiveState(newIndex: number) {
      tabs.forEach((tab, i) => {
        if (i === newIndex) {
          tab.classList.add('bg-white/15', 'border-white/30', 'text-white');
          tab.classList.remove('bg-black/40', 'border-white/10', 'text-white/50');
        } else {
          tab.classList.remove('bg-white/15', 'border-white/30', 'text-white');
          tab.classList.add('bg-black/40', 'border-white/10', 'text-white/50');
        }
      });

      if (counter) {
        counter.textContent = `0${newIndex + 1} / 0${total}`;
      }
    }

    function showSequence(index: number) {
      if (index === currentIndex && tweenProgress) return;

      const prevIndex = currentIndex;
      currentIndex = index;

      // 1. Desvanecer slide previo
      if (bgSlides[prevIndex]) {
        gsap.to(bgSlides[prevIndex], { opacity: 0, duration: 0.8, ease: 'power2.inOut' });
      }
      if (contentSlides[prevIndex]) {
        gsap.to(contentSlides[prevIndex], {
          opacity: 0,
          y: -15,
          duration: 0.4,
          ease: 'power2.in',
          onComplete: () => {
            contentSlides[prevIndex].style.position = 'absolute';
            contentSlides[prevIndex].style.pointerEvents = 'none';
          }
        });
      }

      // 2. Transición del nuevo fondo con sutil Dolly Zoom
      const nextBg = bgSlides[currentIndex];
      const nextImg = nextBg.querySelector<HTMLElement>('.imax-slide-img');
      nextBg.style.opacity = '1';
      gsap.fromTo(nextBg, { opacity: 0 }, { opacity: 1, duration: 0.8, ease: 'power2.inOut' });
      if (nextImg) {
        gsap.fromTo(nextImg, { scale: 1.08 }, { scale: 1.0, duration: SEQUENCE_DURATION, ease: 'none' });
      }

      // 3. Revelado del contenido con Stagger Cinematográfico
      const nextContent = contentSlides[currentIndex];
      nextContent.style.position = 'relative';
      nextContent.style.pointerEvents = 'auto';

      const elements = nextContent.querySelectorAll<HTMLElement>('.slide-elem');
      gsap.fromTo(elements,
        { opacity: 0, y: 25 },
        { opacity: 1, y: 0, duration: 0.6, stagger: 0.08, ease: 'expo.out' }
      );

      // 4. Actualizar tabs e interfaz
      updateActiveState(currentIndex);

      // 5. Reiniciar barra de progreso y temporizador
      startSequenceProgress();
    }

    function startSequenceProgress() {
      if (tweenProgress) {
        tweenProgress.kill();
        tweenProgress = null;
      }
      if (sequenceTimer) {
        clearTimeout(sequenceTimer);
        sequenceTimer = null;
      }

      progressBars.forEach((bar, idx) => {
        if (idx !== currentIndex) {
          bar.style.width = '0%';
        }
      });

      const currentBar = progressBars[currentIndex];
      if (!currentBar) return;

      currentBar.style.width = '0%';
      tweenProgress = gsap.to(currentBar, {
        width: '100%',
        duration: SEQUENCE_DURATION,
        ease: 'none',
        paused: isPaused,
        onComplete: () => {
          if (!isPaused) {
            const next = (currentIndex + 1) % total;
            showSequence(next);
          }
        }
      });
    }

    // Interacción al hacer clic en los tabs de secuencia
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = Number(tab.getAttribute('data-target-seq'));
        if (!isNaN(target)) {
          showSequence(target);
        }
      });
    });

    // Pausar y reanudar con hover
    visor.addEventListener('mouseenter', () => {
      isPaused = true;
      if (tweenProgress) tweenProgress.pause();
    });

    visor.addEventListener('mouseleave', () => {
      isPaused = false;
      if (tweenProgress) tweenProgress.resume();
    });

    // Iniciar con la primera secuencia
    showSequence(0);

    activeManager = {
      kill: () => {
        if (tweenProgress) tweenProgress.kill();
        if (sequenceTimer) clearTimeout(sequenceTimer);
        gsap.killTweensOf(bgSlides);
        gsap.killTweensOf(contentSlides);
      }
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initImaxVisor);
  } else {
    initImaxVisor();
  }
  document.addEventListener('astro:page-load', initImaxVisor);
</script>
