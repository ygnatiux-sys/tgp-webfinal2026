---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Xavier Benítez | The Great Puzzle Project">
	<!-- LENS GLOWS -->
	<div class="lens-glow -top-50 -left-50"></div>
	<div class="lens-glow -bottom-50 -right-50"></div>

	<Navbar />

	<main class="relative z-10 overflow-x-hidden pt-20">
		<!-- ABOUT SECTION -->
		<section id="about" class="relative py-40 bg-bg px-6 md:px-16 overflow-hidden min-h-screen flex items-center justify-center">
			<div class="max-w-6xl mx-auto w-full">
				<div class="relative w-full max-w-175 aspect-square rounded-4xl overflow-hidden bento-glass group mx-auto shadow-2xl">
					<!-- Artist Background Image -->
					<img src="https://storage.thegreatpuzzleproject.com/vault-media/1792044297934-234333e7.webp" alt="Xavier Benítez" class="absolute inset-0 w-full h-full object-cover object-[center_20%] tgp-img-protected grayscale brightness-50 transition-all duration-1000 group-hover:scale-105 group-hover:grayscale-0 group-hover:brightness-75" />
					
					<!-- Top Label -->
					<div class="absolute top-12 left-12 z-20">
						<span class="font-inter text-[10px] uppercase tracking-[0.5em] opacity-60">Información sobre el autor</span>
					</div>

					<!-- Bottom Content -->
					<div class="absolute inset-0 bg-linear-to-t from-bg via-transparent to-transparent opacity-90"></div>
					
					<div class="absolute bottom-12 left-12 right-12 z-20 flex flex-col md:items-start justify-between gap-6">
						<div class="max-w-3xl">
							<h2 class="t-display text-4xl sm:text-6xl md:text-7xl mb-3 leading-none">Xavier Benítez</h2>
							<div class="flex items-center gap-3 mb-4">
								<div class="w-8 h-px bg-vault-accent/60"></div>
								<span class="t-telemetry text-vault-accent">Arquitecto de Nichos Simbólicos</span>
							</div>
							<p class="font-inter font-light text-sm md:text-base leading-relaxed text-white/80 max-w-xl">
								Investigador y arquitecto de nichos simbólicos. Su trabajo se sitúa en la intersección de la neurohistoria, la antropología filosófica y la teoría técnica, cartografiando los procesos de exclusión y amnesia programada en la era digital.
							</p>
						</div>

						<a href="/proyectos" class="btn-glass inline-flex items-center gap-3 group/btn">
							<span>Explorar Trayectoria</span>
							<span class="group-hover/btn:translate-x-1 transition-transform">→</span>
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
