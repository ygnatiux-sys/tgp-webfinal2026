---
// src/pages/historia-alternativa.astro
// Historia Alternativa & Arqueología Especulativa — The Great Puzzle Project
// Cartel Univisium de Apple (2:1) + Grilla "Staggered Editorial" A24 / Apple Editorial (Escalonado Asimétrico)

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { detectFocalPoint } from '../lib/focalPointDetector';
import { getCollection } from 'astro:content';

// Sanitizador de texto Markdown crudo para descripciones/extractos
const sanitizeSnippet = (text: string) => {
  return text
    .replace(/^[#*\->\s]+/gm, '')
    .replace(/[*_~`]/g, '')
    .trim();
};

const DEFAULT_VAULT_IMAGE = 'https://storage.thegreatpuzzleproject.com/vault-media/1792193779598-ffcdb2f8.webp';

// Casos de Investigación de Historia Alternativa (Curaduría Base)
const casosCurados = [
  {
    id: 'masuda-no-iwafune',
    title: 'Masuda no Iwafune: La Nave de Roca y el Abismo del Tiempo en Asuka',
    subtitle: 'Granito, Geometría Cenital y la Memoria Suspendida del Periodo Imperial',
    category: 'Arqueología Megalítica Japonesa & Cronologías Disidentes',
    date: 'c. 650 d.C.',
    era: 'Período Asuka / Horizonte Arcaico (c. Siglo VII d.C. o anterior)',
    imageUrl: 'https://storage.thegreatpuzzleproject.com/vault-media/1792133914689-44dd5943.webp',
    excerpt: '### Suspendida en la neblina topográfica de la Prefectura de Nara, una anomalía de granito de ochocientas toneladas desafía la exégesis arqueológica. Sus incisiones perfectas y su abandono abrupto articulan un silencio que interpela tanto la ingeniería imperial del siglo VII como la cosmología arcaica del Japón prehistórico.',
    badge: 'Anomalía Lítica de Asuka',
    url: '/ensayos/masuda-no-iwafune'
  },
  {
    id: 'las-cuevas-de-longyou-en-china',
