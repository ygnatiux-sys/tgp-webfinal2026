---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import AppleShowcaseBento from '../components/AppleShowcaseBento.astro';
---

<Layout title="Media Lab | The Great Puzzle Project" bodyStyle="background-color: #070709;">
	<!-- LENS GLOWS -->
	<div class="lens-glow -top-50 -left-50 opacity-40"></div>
	<div class="lens-glow -bottom-50 -right-50 opacity-40"></div>

	<Navbar />

	<main class="relative z-10 min-h-screen bg-[#070709] overflow-x-hidden pt-24 md:pt-32 pb-32" style="--color-bg: #070709; --main-bg: #070709;">
		<!-- MEDIA LAB HEADER CINEMÁTICO -->
		<PageHeader
			kicker="THE GREAT PUZZLE PROJECT · LABORATORIO TRANSMEDIA"
			title="Media"
			accent="Lab"
			logline="Exploración transmedia, arqueología de las ideas en formato sonoro y prototipado simbólico."
			primaryAction={{
				href: "/media",
				label: "Ver Canales & Plataformas",
				icon: "→"
			}}
		/>

		<!-- MEDIA LAB SECTION -->
		<section id="media" class="px-6 md:px-16 bg-[#070709] relative overflow-hidden">

			<!-- Media Lab Category Bentos -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10 max-w-6xl mx-auto">
				<a href="/media" class="block bento-glass rounded-4xl p-10 group cursor-pointer h-full text-center">
					<div class="flex flex-col items-center mb-8">
						<h2 class="t-display text-3xl sm:text-4xl italic mb-3 text-white group-hover:text-vault-accent transition-colors duration-500">Eventos</h2>
						<span class="text-2xl text-vault-accent/40 group-hover:text-vault-accent transition-all group-hover:translate-y-1">↓</span>
					</div>
					<p class="font-inter text-sm font-light text-white/70 group-hover:text-white transition-opacity">Conferencias & Simposios internacionales.</p>
				</a>

				<a href="/media" class="block bento-glass rounded-4xl p-10 group cursor-pointer h-full text-center">
					<div class="flex flex-col items-center mb-8">
						<h2 class="t-display text-4xl italic mb-3 text-white group-hover:text-vault-accent transition-colors duration-500">Podcast</h2>
						<span class="text-2xl text-vault-accent/40 group-hover:text-vault-accent transition-all group-hover:translate-y-1">↓</span>
					</div>
					<p class="font-inter text-sm font-light text-white/70 group-hover:text-white transition-opacity">Arqueología de las ideas en formato audio.</p>
				</a>

				<a href="/media" class="block bento-glass rounded-4xl p-10 group cursor-pointer h-full text-center">
					<div class="flex flex-col items-center mb-8">
						<h2 class="t-display text-4xl italic mb-3 text-white group-hover:text-vault-accent transition-colors duration-500">Lab</h2>
						<span class="text-2xl text-vault-accent/40 group-hover:text-vault-accent transition-all group-hover:translate-y-1">↓</span>
					</div>
					<p class="font-inter text-sm font-light text-white/70 group-hover:text-white transition-opacity">Prototipado de nichos simbólicos.</p>
				</a>
			</div>

			<!-- Contact CTA -->
			<div class="w-full bento-glass p-8 md:p-20 flex flex-col items-center text-center rounded-[3rem] group mt-32 relative overflow-hidden max-w-6xl mx-auto">
				<div class="absolute -top-24 -right-24 w-64 h-64 bg-vault-accent/5 rounded-full blur-[100px] pointer-events-none"></div>
				<div class="absolute -bottom-24 -left-24 w-64 h-64 bg-vault-loading/5 rounded-full blur-[100px] pointer-events-none"></div>
				
				<div class="relative z-10 max-w-3xl">
					<h3 class="t-display text-5xl md:text-7xl leading-tight mb-6">
						¿Deseas explorar el <span class="italic font-light text-vault-accent">nicho</span>?
					</h3>
					<p class="t-logline text-lg md:text-2xl text-white/80 max-w-xl mx-auto mb-10">
						«Construyendo herramientas cognitivas y espacios de memoria en la era de la saturación técnica.»
					</p>
					<div class="flex justify-center">
						<a href="mailto:ygnatiux@gmail.com" class="btn-glass text-xs! uppercase tracking-[0.25em] px-10! py-4!">
							<span>Unirse al Puzzle</span>
							<span class="text-sm">→</span>
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- BENTO SHOWCASE: 3D Z-DROP MASONRY (POSTS & COLECCIONES TGP) -->
		<AppleShowcaseBento />
	</main>

	<Footer />
</Layout>
