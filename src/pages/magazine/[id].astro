---
// src/pages/magazine/[id].astro
// REVISTA UNIFICADA — Cada imagen es una página/spread completa 60/40 con su excerpt y texto
// Soporta hidratación dinámica en vivo (localStorage / sessionStorage) y renderizado estático

export function getStaticPaths() {
  return [
    { params: { id: 'test' } },
    { params: { id: 'viewer' } },
    { params: { id: 'draft' } },
    { params: { id: 'draft_id' } },
    { params: { id: 'gobekli-tepe' } },
    { params: { id: 'pompeya' } },
    { params: { id: 'pompeya-vesubio' } },
    { params: { id: 'biblioteca-alejandria' } },
  ];
}

const { id } = Astro.params;

const GOBEKLI_PAGES = [
  {
    folio: '01',
    tag: 'FOLIO I · EL ORIGEN SAGRADO',
    title: 'Göbekli Tepe',
    subtitle: 'El santuario antes del tiempo',
    excerpt: 'Doce mil años antes de que los primeros faraones pusieran la primera piedra, manos anónimas esculpieron pilares de caliza de seis toneladas en las colinas de Anatolia. Göbekli Tepe no es solo el templo más antiguo del mundo: es la evidencia de que la religión antecede a la agricultura.',
    body: 'En 1994, el arqueólogo Klaus Schmidt llegó a una colina ondulada que los lugareños llamaban la montaña con ombligo. Lo que encontró bajo la superficie reescribió los manuales de prehistoria. Göbekli Tepe reveló un complejo de al menos veinte recintos circulares con pilares en forma de T de hasta cinco metros y dieciséis toneladas.\n\nPara levantar estas estructuras se necesitaron cientos de personas coordinadas durante generaciones. Pero no hay rastros de vivienda permanente: Göbekli Tepe era un destino ritual periódico.',
    imageUrl: '/magazine-hero-gobekli.jpg',
    imageCaption: 'Recinto C de Göbekli Tepe, ca. 9500 a.C. Los pilares centrales representan figuras antropomorfas estilizadas.',
    imageCredit: 'Archaeological survey, southeast Anatolia',
    date: '3 septiembre 2026',
    slug: 'gobekli-tepe',
    readingTime: '6 min'
  },
  {
    folio: '02',
    tag: 'FOLIO II · LA ARQUITECTURA CÓSMICA',
    title: 'La Geometría de lo Sagrado',
    subtitle: 'Estratigrafía del décimo milenio',
    excerpt: 'Bajo la colina se entrelazan al menos veinte círculos concéntricos de piedra. Cada recinto fue deliberadamente enterrado tras siglos de uso ceremonial, como si la clausura del templo fuera tan sagrada como su consagración.',
    body: 'La precisión geométrica de los recintos A, B, C y D sugiere alineaciones astronómicas con Sirio y las Pléyades. Los constructores del Neolítico Precerámico no solo dominaban la extracción megalítica, sino un calendario ritual vinculado a los ciclos celestes y a la memoria colectiva.',
    imageUrl: 'https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3e/The_archaeological_site_of_G%C3%B6bekli_Tepe_-_main_excavation_area.png/1280px-The_archaeological_site_of_G%C3%B6bekli_Tepe_-_main_excavation_area.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail',
    imageCaption: 'Excavación general del recinto megalítico principal con estructuras circulares de soporte.',
    imageCredit: 'Deutsches Archäologisches Institut',
    date: '3 septiembre 2026',
    slug: 'gobekli-tepe/estratigrafia',
    readingTime: '4 min'
  },
  {
    folio: '03',
    tag: 'FOLIO III · EL BESTIARIO TOTÉMICO',
    title: 'El Umbral Simbólico',
    subtitle: 'Relieves en el corazón de la caliza',
    excerpt: 'Leopardos, buitres sin cabeza, zorros y escorpiones pueblan la superficie de los monolitos. No son meras decoraciones cinegéticas: representan el umbral mítico entre los cazadores y el más allá.',
    body: 'En las culturas chamánicas de Anatolia, el buitre es el psicopompo que transporta el alma de los difuntos hacia el firmamento. Los pilares de Göbekli Tepe son monolitos personificados: brazos estilizados doblados hacia el cinturón y manos talladas en bajo relieve protegiendo el centro del mundo.',
    imageUrl: 'https://upload.wikimedia.org/wikipedia/commons/d/d4/G%C3%B6bekli_Tepe_Birthing_Woman_in_Leopard_Pillar_Building.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled',
    imageCaption: 'Pilar con grabado zoomorfo de leopardo y relieves de la fauna pleistocénica.',
    imageCredit: 'Şanlıurfa Museum Collection',
    date: '3 septiembre 2026',
    slug: 'gobekli-tepe/simbologia',
    readingTime: '5 min'
  }
];

const POMPEYA_PAGES = [
  {
    folio: '01',
    tag: 'FOLIO I · LA CATÁSTROFE Y LA ROCA',
    title: 'Pompeya y el Vesubio',
    subtitle: 'La paradoja de la piedra y la eternidad',
    excerpt: 'Bajo el manto de cenizas del 79 d.C., una civilización quedó petrificada en un diálogo suspendido entre la fragilidad humana y la fuerza geológica.',
    body: 'En el otoño del 79 d.C., el Vesubio despertó con una fuerza descomunal. La lluvia de piedra pómez y los flujos piroclásticos sellaron una ciudad viva en el cenit de su dinamismo comercial y artístico.\n\nPompeya no es solo una ruina: es una fotografía geológica tridimensional de la vida romana cotidiana, donde los frescos aún respiran con el rojo cinabrio intacto.',
    imageUrl: 'https://storage.thegreatpuzzleproject.com/vault-media/magazine/pompeya-y-el-vesubio/vesuvius-from-pompeii-hires-version-2png.webp',
    imageCaption: 'El cono del Vesubio recortado contra el horizonte desde el Foro civil de Pompeya.',
    imageCredit: 'Archivo TGP Vault / Wikimedia Commons',
    date: '3 septiembre 2026',
    slug: 'pompeya/vesubio',
    readingTime: '5 min'
  },
  {
    folio: '02',
    tag: 'FOLIO II · LA INTIMIDAD EN LOS MUROS',
    title: 'El Cuarto Estilo Pompeyano',
    subtitle: 'Mitos, dioses y pasiones cotidianas',
    excerpt: 'Los muros domésticos y los espacios públicos se transformaron en complejas arquitecturas ilusionistas. Desde los cultos a Príapo e Isis hasta los frescos del Lupanar, la sexualidad y la religión convivían sin la censura moderna.',
    body: 'El arte pompeyano del Cuarto Estilo desafía la rigidez del mármol. En las casas de los Vettii y del Fauno, los pintores anónimos crearon perspectivas fantásticas y representaciones mitológicas que servían tanto de talismanes apotropaicos como de manifiestos de estatus.\n\nCada pigmento extraído de minerales orientales testimonia las vastas redes comerciales del Mediterráneo antiguo.',
    imageUrl: 'https://upload.wikimedia.org/wikipedia/commons/b/b1/Pirito_e_ippodamia_ricevono_l%27omaggio_dei_centauri%2C_9044%2C_01.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original',
    imageCaption: 'Fresco de Pirítoo e Hipodamía recibiendo el homenaje de los centauros, Museo Arqueológico Nacional de Nápoles.',
    imageCredit: 'MANN Collection / Dominio Público',
    date: '3 septiembre 2026',
    slug: 'pompeya/frescos',
    readingTime: '4 min'
  },
  {
    folio: '03',
    tag: 'FOLIO III · LA ESTRATIGRAFÍA DEL OLVIDO',
    title: 'El Silencio de la Ceniza',
    subtitle: 'Memoria preservada por la destrucción',
    excerpt: 'La misma capa piroclástica que aniquiló la vida preservó las cartas, los grafitis electorales, las recetas de cocina y los moldes de yeso de los últimos habitantes.',
    body: 'La paradoja de Pompeya es que su supervivencia histórica dependió de su destrucción total. Mientras el resto del Imperio Romano se degradó por el expolio medieval y las sucesivas reconstrucciones, Pompeya quedó detenida en una cápsula hermética.\n\nCaminar hoy por la Vía de la Abundancia es escuchar los ecos de una conversación interrumpida hace dos mil años.',
    imageUrl: 'https://upload.wikimedia.org/wikipedia/commons/b/bf/Fresco_Isis_Pompeya_02.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original',
    imageCaption: 'Estructuras ornamentales con iconografía isíaca en las domus de Pompeya.',
    imageCredit: 'Parco Archeologico di Pompei',
    date: '3 septiembre 2026',
    slug: 'pompeya/memoria',
    readingTime: '4 min'
  }
];

const ALEJANDRIA_PAGES = [
  {
    folio: '01',
    tag: 'FOLIO I · LA UTOPÍA EPISTEMOLÓGICA',
    title: 'La Biblioteca de Alejandría',
    subtitle: 'El sueño del conocimiento universal',
    excerpt: 'El intento más ambicioso de la antigüedad por concentrar todo el saber del mundo conocido en un solo espacio sagrado de papiros y filosofía.',
    body: 'En la desembocadura del Nilo, los Ptolomeos no erigieron un mero archivo, sino un palacio del pensamiento. Los navíos que fondeaban en el puerto eran obligados a entregar cualquier manuscrito para ser copiado con fervor.\n\nAlejandría demostró que el saber no es una acumulación pasiva, sino una arquitectura activa que conecta civilizaciones.',
    imageUrl: 'https://upload.wikimedia.org/wikipedia/commons/thumb/d/d4/Ancient_Library_of_Alexandria.jpg/1280px-Ancient_Library_of_Alexandria.jpg',
    imageCaption: 'Reconstrucción histórica del interior de la Gran Biblioteca de Alejandría.',
    imageCredit: 'Archivo Histórico Clásico / Wikimedia Commons',
    date: 'Agosto 2026',
    slug: 'alejandria/origen',
    readingTime: '5 min'
  },
  {
    folio: '02',
    tag: 'FOLIO II · EL MAPA DEL SABER',
    title: 'Calímaco y los Pinakes',
    subtitle: 'La invención de la memoria clasificada',
    excerpt: 'Al ordenar miles de rollos por disciplinas, Calímaco inventó el catálogo bibliográfico y demostró que pensar es clasificar y conectar fragmentos dispersos.',
    body: 'En las salas del Museo alejandrino, Eratóstenes calculó la circunferencia de la Tierra con una vara y una sombra, mientras Euclides sistematizaba la geometría del espacio.\n\nAquel centro del mundo helénico fue la cuna donde la ciencia moderna aprendió a formular sus preguntas cardinales.',
    imageUrl: 'https://upload.wikimedia.org/wikipedia/commons/4/4e/Dusk_landscape_high_resolution.jpg',
    imageCaption: 'Atardecer sobre las aguas del Mediterráneo oriental frente al antiguo Faro de Alejandría.',
    imageCredit: 'Wikimedia Commons · Dominio Público',
    date: 'Agosto 2026',
    slug: 'alejandria/pinakes',
    readingTime: '4 min'
  },
  {
    folio: '03',
    tag: 'FOLIO III · LA MEMORIA ROTA',
    title: 'El Mito del Fuego',
    subtitle: 'La disolución del diálogo entre los siglos',
    excerpt: 'Más allá de la leyenda del incendio dramático, la biblioteca se desvaneció lentamente en el polvo del abandono, recordándonos que el saber muere cuando se deja de leer.',
    body: 'La pérdida de Alejandría nos legó una advertencia indeleble para la era digital: ningún servidor ni soporte físico es invulnerable al olvido institucional si se quiebra la voluntad de preservar el sentido colectivo.',
    imageUrl: '/magazine-hero-gobekli.jpg',
    imageCaption: 'Monolito megalítico evocador de las primeras inscripciones de la memoria humana.',
    imageCredit: 'The Great Puzzle Project Archive',
    date: 'Agosto 2026',
    slug: 'alejandria/olvido',
    readingTime: '4 min'
  }
];

const MAGAZINES_DATABASE: Record<string, typeof GOBEKLI_PAGES> = {
  'gobekli-tepe': GOBEKLI_PAGES,
  'test': GOBEKLI_PAGES,
  'pompeya': POMPEYA_PAGES,
  'pompeya-vesubio': POMPEYA_PAGES,
  'biblioteca-alejandria': ALEJANDRIA_PAGES,
  'viewer': ALEJANDRIA_PAGES,
};

const MOCK_PAGES = MAGAZINES_DATABASE[id as string] || GOBEKLI_PAGES;
const initialPage = MOCK_PAGES[0];
---
<!DOCTYPE html>
<html lang="es" class="theme-charcoal">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title id="page-title">{initialPage.title} — TGP Magazine</title>
  <meta id="page-desc" name="description" content={initialPage.excerpt} />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,700;1,6..96,400&family=Inter:wght@200;300;400;500;600&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* TEMAS DUALES */
    html.theme-charcoal {
      --bg: #0f0f0f;
      --bg-panel: rgba(20, 20, 20, 0.95);
      --text-primary: #f0ede8;
      --text-muted: rgba(240, 237, 232, 0.68);
      --text-dim: rgba(240, 237, 232, 0.45);
      --accent: #c9a96e;
      --accent-soft: rgba(201, 169, 110, 0.15);
      --border: rgba(255, 255, 255, 0.08);
      --shadow: rgba(0, 0, 0, 0.85);
      --caption-bg: rgba(15, 15, 15, 0.82);
      --tag-bg: rgba(201, 169, 110, 0.12);
      --tag-color: #c9a96e;
      --control-bg: rgba(255, 255, 255, 0.05);
      --control-hover: rgba(255, 255, 255, 0.14);
      --card-active: rgba(201, 169, 110, 0.2);
    }

    html.theme-paper {
      --bg: #f4f1eb;
      --bg-panel: rgba(244, 241, 235, 0.95);
      --text-primary: #181715;
      --text-muted: rgba(24, 23, 21, 0.75);
      --text-dim: rgba(24, 23, 21, 0.52);
      --accent: #8b6b38;
      --accent-soft: rgba(139, 107, 56, 0.15);
      --border: rgba(0, 0, 0, 0.1);
      --shadow: rgba(0, 0, 0, 0.16);
      --caption-bg: rgba(244, 241, 235, 0.9);
      --tag-bg: rgba(139, 107, 56, 0.1);
      --tag-color: #8b6b38;
      --control-bg: rgba(0, 0, 0, 0.05);
      --control-hover: rgba(0, 0, 0, 0.12);
      --card-active: rgba(139, 107, 56, 0.2);
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text-primary);
      transition: background 0.4s ease, color 0.4s ease;
    }

    /* Brillo fotográfico para Charcoal */
    html.theme-charcoal body::after {
      content: '';
      position: fixed;
      inset: 0;
      background: radial-gradient(ellipse 65% 50% at 85% 10%, rgba(201,169,110,0.08) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    /* Textura de papel para Paper Glow */
    html.theme-paper body::after {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
      opacity: 0.035;
      mix-blend-mode: multiply;
      pointer-events: none;
      z-index: 0;
    }

    .mag-viewer {
      position: relative;
      width: 100vw;
      height: 100vh;
      z-index: 1;
    }

    /* Grid 60/40 */
    .mag-grid {
      display: grid;
      grid-template-columns: 6fr 4fr;
      width: 100%;
      height: 100%;
    }

    /* ── BLOQUE VISUAL 60% ── */
    .mag-visual {
      position: relative;
      height: 100vh;
      overflow: hidden;
    }

    .mag-visual__img-wrapper {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    .mag-visual__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      border-radius: 0 24px 24px 0;
      box-shadow: 12px 0 70px var(--shadow);
      transition: opacity 0.4s ease, transform 6s ease;
    }

    .mag-visual:hover .mag-visual__img {
      transform: scale(1.025);
    }

    .mag-visual__overlay {
      position: absolute;
      inset: 0;
      border-radius: 0 24px 24px 0;
      background: linear-gradient(to right, rgba(0,0,0,0) 65%, rgba(0,0,0,0.35) 100%),
                  linear-gradient(to top, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0) 45%);
      pointer-events: none;
    }

    .mag-visual__caption {
      position: absolute;
      bottom: 32px;
      left: 32px;
      right: 32px;
      padding: 16px 20px;
      background: var(--caption-bg);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border-radius: 12px;
      border: 1px solid var(--border);
      font-size: 11px;
      font-weight: 300;
      letter-spacing: 0.04em;
      color: var(--text-primary);
      line-height: 1.6;
      transition: opacity 0.3s ease;
    }

    .mag-visual__caption strong {
      display: block;
      font-weight: 500;
      margin-bottom: 3px;
      color: var(--accent);
    }

    /* ── BLOQUE CONTENIDO 40% ── */
    .mag-content {
      height: 100vh;
      overflow-y: auto;
      overflow-x: hidden;
      padding: 72px 52px 48px;
      display: flex;
      flex-direction: column;
      scrollbar-width: thin;
      scrollbar-color: var(--border) transparent;
      transition: opacity 0.35s ease;
    }

    .mag-content::-webkit-scrollbar { width: 4px; }
    .mag-content::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

    .mag-tag {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 6px 14px;
      background: var(--tag-bg);
      color: var(--tag-color);
      border-radius: 30px;
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      margin-bottom: 24px;
      width: fit-content;
    }

    .mag-tag__dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--tag-color);
      animation: pulse 2.2s ease-in-out infinite;
    }

    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }

    .mag-title {
      font-family: 'Bodoni Moda', Georgia, serif;
      font-size: clamp(2.4rem, 3.8vw, 4.4rem);
      font-weight: 400;
      line-height: 1.05;
      letter-spacing: -0.02em;
      color: var(--text-primary);
      margin-bottom: 12px;
      transition: opacity 0.3s ease;
    }

    .mag-subtitle {
      font-family: 'Bodoni Moda', Georgia, serif;
      font-size: clamp(1rem, 1.35vw, 1.25rem);
      font-weight: 400;
      font-style: italic;
      color: var(--text-muted);
      margin-bottom: 28px;
      line-height: 1.4;
      transition: opacity 0.3s ease;
    }

    .mag-divider {
      width: 48px;
      height: 1px;
      background: var(--accent);
      margin-bottom: 28px;
      opacity: 0.7;
    }

    .mag-excerpt {
      font-size: clamp(0.88rem, 1.1vw, 1rem);
      font-weight: 300;
      line-height: 1.88;
      color: var(--text-muted);
      margin-bottom: 28px;
      transition: opacity 0.3s ease;
    }

    .mag-body {
      font-size: clamp(0.83rem, 1vw, 0.9rem);
      font-weight: 300;
      line-height: 1.95;
      color: var(--text-dim);
      transition: opacity 0.3s ease;
    }

    .mag-body p + p { margin-top: 16px; }

    /* ── TIRA INFERIOR DE PÁGINAS / SPREADS ── */
    .mag-spreads-nav {
      margin-top: 36px;
      padding-top: 24px;
      border-top: 1px solid var(--border);
    }

    .mag-spreads-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }

    .mag-spreads-title {
      font-size: 9px;
      font-family: monospace;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent);
    }

    .mag-spreads-hint {
      font-size: 9px;
      font-family: monospace;
      letter-spacing: 0.08em;
      color: var(--text-dim);
    }

    .mag-spreads-track {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 4px;
    }

    .mag-spreads-track::-webkit-scrollbar { display: none; }

    .mag-spread-thumb {
      flex: 0 0 110px;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid var(--border);
      background: var(--control-bg);
      cursor: pointer;
      text-align: left;
      transition: all 0.25s ease;
      position: relative;
    }

    .mag-spread-thumb:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }

    .mag-spread-thumb.active {
      border-color: var(--accent);
      box-shadow: 0 0 14px var(--accent-soft);
    }

    .mag-spread-thumb img {
      width: 100%;
      height: 60px;
      object-fit: cover;
      display: block;
    }

    .mag-spread-thumb__info {
      padding: 6px 8px;
    }

    .mag-spread-thumb__num {
      font-size: 8px;
      font-family: monospace;
      font-weight: 600;
      color: var(--accent);
      letter-spacing: 0.1em;
      display: block;
    }

    .mag-spread-thumb__title {
      font-size: 8.5px;
      font-weight: 400;
      color: var(--text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      display: block;
    }

    /* Botón siguiente página al pie */
    .mag-next-page-banner {
      margin-top: 20px;
      padding: 12px 16px;
      border-radius: 10px;
      background: var(--control-bg);
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .mag-next-page-banner:hover {
      background: var(--control-hover);
      border-color: var(--accent);
    }

    .mag-next-page-banner span {
      font-size: 10px;
      font-family: monospace;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
    }

    .mag-next-page-banner strong {
      font-size: 11px;
      font-weight: 400;
      color: var(--text-primary);
    }

    .mag-spacer { flex: 1; min-height: 28px; }

    .mag-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 20px;
      border-top: 1px solid var(--border);
      margin-top: 16px;
    }

    .mag-meta__date, .mag-meta__read {
      font-size: 10px;
      font-weight: 300;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-dim);
    }

    .mag-meta__slug {
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
    }

    /* ── BARRA SUPERIOR CON PAGINADOR EDITORIAL ── */
    .mag-topbar {
      position: fixed;
      top: 20px;
      left: 28px;
      right: 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      pointer-events: none;
      z-index: 100;
    }

    .mag-topbar > * { pointer-events: auto; }

    /* Theme Switcher */
    .mag-theme-switcher {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: var(--caption-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      padding: 4px 6px;
      border-radius: 30px;
      border: 1px solid var(--border);
    }

    .mag-theme-btn {
      background: transparent;
      border: none;
      color: var(--text-dim);
      font-family: 'Inter', sans-serif;
      font-size: 9px;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 5px 10px;
      border-radius: 20px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .mag-theme-btn.active {
      background: var(--accent);
      color: #111;
      font-weight: 600;
    }

    /* Paginador Editorial Central */
    .mag-pagination {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: var(--caption-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      padding: 5px 14px;
      border-radius: 30px;
      border: 1px solid var(--border);
      box-shadow: 0 4px 20px rgba(0,0,0,0.35);
    }

    .mag-page-btn {
      background: transparent;
      border: none;
      color: var(--text-primary);
      cursor: pointer;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s, transform 0.2s;
    }

    .mag-page-btn:hover:not(:disabled) {
      background: var(--control-hover);
      transform: scale(1.1);
      color: var(--accent);
    }

    .mag-page-btn:disabled {
      opacity: 0.25;
      cursor: not-allowed;
    }

    .mag-page-indicator {
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: monospace;
      font-size: 11px;
      letter-spacing: 0.12em;
    }

    .mag-page-label {
      font-size: 8px;
      color: var(--accent);
      text-transform: uppercase;
    }

    .mag-page-current {
      font-weight: 600;
      color: var(--text-primary);
    }

    .mag-page-divider {
      color: var(--text-dim);
    }

    .mag-page-total {
      color: var(--text-dim);
    }

    .mag-close {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--control-bg);
      backdrop-filter: blur(16px);
      border: 1px solid var(--border);
      cursor: pointer;
      text-decoration: none;
      transition: background 0.2s, transform 0.2s;
      color: var(--text-primary);
    }

    .mag-close:hover {
      background: var(--control-hover);
      transform: scale(1.08);
    }

    .mag-close svg { width: 15px; height: 15px; }

    /* Clases de animación de cambio de página */
    .fade-out {
      opacity: 0 !important;
    }

    /* Mobile */
    @media(max-width: 860px){
      html, body { overflow: auto; }
      .mag-viewer, .mag-grid { height: auto; }
      .mag-grid { grid-template-columns: 1fr; }
      .mag-visual { height: 65vw; min-height: 290px; max-height: 480px; }
      .mag-visual__img, .mag-visual__overlay { border-radius: 0 0 24px 24px; }
      .mag-content { height: auto; overflow: visible; padding: 36px 20px 60px; }
      .mag-title { font-size: 2.2rem; }
      .mag-topbar { top: 12px; left: 14px; right: 14px; }
      .mag-pagination { padding: 4px 10px; }
    }
  </style>
</head>
<body>

<div class="mag-viewer">

  <!-- ─── BARRA SUPERIOR CON CONTROLES Y PAGINADOR EDITORIAL ─── -->
  <div class="mag-topbar">
    <!-- Selector de tema -->
    <div class="mag-theme-switcher" role="group" aria-label="Cambiar tema">
      <button type="button" class="mag-theme-btn active" id="btn-charcoal" onclick="setTheme('charcoal')">✦ Charcoal</button>
      <button type="button" class="mag-theme-btn" id="btn-paper" onclick="setTheme('paper')">◈ Paper</button>
    </div>

    <!-- Paginador central de la revista unificada -->
    <div class="mag-pagination" role="navigation" aria-label="Navegación de páginas">
      <button type="button" class="mag-page-btn" id="prev-page-btn" aria-label="Página anterior" onclick="changePage(-1)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="mag-page-indicator">
        <span class="mag-page-label">FOLIO</span>
        <span class="mag-page-current" id="current-page-num">01</span>
        <span class="mag-page-divider">/</span>
        <span class="mag-page-total" id="total-pages-num">03</span>
      </div>

      <button type="button" class="mag-page-btn" id="next-page-btn" aria-label="Página siguiente" onclick="changePage(1)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <!-- Botón volver a la Bóveda -->
    <a href="/tgp-vault" class="mag-close" aria-label="Volver a la Bóveda">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </a>
  </div>

  <div class="mag-grid">

    <!-- ─── BLOQUE VISUAL 60% ─── -->
    <div class="mag-visual">
      <div class="mag-visual__img-wrapper">
        <img
          id="hero-img"
          class="mag-visual__img"
          src={initialPage.imageUrl}
          alt={initialPage.title}
          loading="eager"
        />
      </div>
      <div class="mag-visual__overlay"></div>
      <div class="mag-visual__caption" id="hero-caption">
        <strong id="caption-strong">{initialPage.imageCaption}</strong>
        <span id="caption-credit">{initialPage.imageCredit}</span>
      </div>
    </div>

    <!-- ─── BLOQUE CONTENIDO 40% ─── -->
    <div class="mag-content" id="mag-content-col">
      <span class="mag-tag" id="article-tag">
        <span class="mag-tag__dot"></span>
        <span id="tag-text">{initialPage.tag}</span>
      </span>

      <h1 class="mag-title" id="article-title">{initialPage.title}</h1>
      <p class="mag-subtitle" id="article-subtitle">{initialPage.subtitle}</p>

      <div class="mag-divider"></div>

      <p class="mag-excerpt" id="article-excerpt">{initialPage.excerpt}</p>

      <div class="mag-body" id="article-body">
        {initialPage.body.split('\n\n').map((p: string) => <p>{p}</p>)}
      </div>

      <!-- Tira de Miniaturas de Folios / Capítulos -->
      <div class="mag-spreads-nav" id="spreads-nav">
        <div class="mag-spreads-header">
          <span class="mag-spreads-title">✦ Folios de la Revista</span>
          <span class="mag-spreads-hint">Usa flechas ← →</span>
        </div>
        <div class="mag-spreads-track" id="spreads-track">
          {MOCK_PAGES.map((page, idx) => (
            <button
              type="button"
              class={`mag-spread-thumb ${idx === 0 ? 'active' : ''}`}
              onclick={`goToPage(${idx})`}
            >
              <img src={page.imageUrl} alt={page.title} loading="lazy" />
              <div class="mag-spread-thumb__info">
                <span class="mag-spread-thumb__num">FOLIO {page.folio}</span>
                <span class="mag-spread-thumb__title">{page.title}</span>
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- Banner de siguiente página -->
      <div class="mag-next-page-banner" id="next-page-banner" onclick="changePage(1)">
        <span>Siguiente Folio →</span>
        <strong id="next-page-title">{MOCK_PAGES[1].title}</strong>
      </div>

      <div class="mag-spacer"></div>

      <div class="mag-meta">
        <span class="mag-meta__date" id="meta-date">{initialPage.date}</span>
        <span class="mag-meta__slug" id="meta-slug">/{initialPage.slug}</span>
        <span class="mag-meta__read" id="meta-read">{initialPage.readingTime}</span>
      </div>
    </div>

  </div>
</div>

<!-- ─── SCRIPT DE CONTROL EDITORIAL MULTI-PÁGINA & TEMAS ─── -->
<script is:inline define:vars={{ defaultPages: MOCK_PAGES }}>
  // Estado global de páginas
  let magazinePages = defaultPages || [];
  let currentPageIndex = 0;

  function setTheme(t) {
    const html = document.documentElement;
    const btnC = document.getElementById('btn-charcoal');
    const btnP = document.getElementById('btn-paper');

    if (t === 'paper') {
      html.className = 'theme-paper';
      btnP?.classList.add('active');
      btnC?.classList.remove('active');
    } else {
      html.className = 'theme-charcoal';
      btnC?.classList.add('active');
      btnP?.classList.remove('active');
    }
  }

  // Renderiza una página específica en pantalla con micro-transición suave
  function renderPage(index, animate = true) {
    if (!magazinePages || magazinePages.length === 0) return;
    if (index < 0 || index >= magazinePages.length) return;

    currentPageIndex = index;
    const page = magazinePages[index];

    const imgEl = document.getElementById('hero-img');
    const capEl = document.getElementById('hero-caption');
    const contentCol = document.getElementById('mag-content-col');

    function updateDOM() {
      // 1. Imagen y pie
      if (imgEl && page.imageUrl) {
        imgEl.src = page.imageUrl;
        imgEl.alt = page.title;
      }
      const elCapStrong = document.getElementById('caption-strong');
      if (elCapStrong) elCapStrong.textContent = page.imageCaption || page.subtitle || '';
      const elCapCredit = document.getElementById('caption-credit');
      if (elCapCredit) elCapCredit.textContent = page.imageCredit || '';

      // 2. Textos
      document.title = `${page.title} — TGP Magazine`;
      const elTag = document.getElementById('tag-text');
      if (elTag) elTag.textContent = page.tag || `FOLIO ${String(index + 1).padStart(2, '0')}`;
      const elTitle = document.getElementById('article-title');
      if (elTitle) elTitle.textContent = page.title;
      const elSub = document.getElementById('article-subtitle');
      if (elSub) elSub.textContent = page.subtitle || '';
      const elExcerpt = document.getElementById('article-excerpt');
      if (elExcerpt) elExcerpt.textContent = page.excerpt || '';
      const elBody = document.getElementById('article-body');
      if (elBody && page.body) {
        elBody.innerHTML = page.body.split('\n\n').map(p => `<p>${p}</p>`).join('');
      }

      // 3. Metadata
      const elDate = document.getElementById('meta-date');
      if (elDate) elDate.textContent = page.date || new Date().toLocaleDateString('es-ES');
      const elSlug = document.getElementById('meta-slug');
      if (elSlug) elSlug.textContent = `/${page.slug || 'magazine'}`;
      const elRead = document.getElementById('meta-read');
      if (elRead) elRead.textContent = page.readingTime || '5 min lectura';

      // 4. Paginador
      const elCurNum = document.getElementById('current-page-num');
      if (elCurNum) elCurNum.textContent = String(index + 1).padStart(2, '0');
      const elTotNum = document.getElementById('total-pages-num');
      if (elTotNum) elTotNum.textContent = String(magazinePages.length).padStart(2, '0');

      const prevBtn = document.getElementById('prev-page-btn');
      const nextBtn = document.getElementById('next-page-btn');
      if (prevBtn) prevBtn.disabled = index === 0;
      if (nextBtn) nextBtn.disabled = index === magazinePages.length - 1;

      // 5. Miniaturas activas
      const thumbs = document.querySelectorAll('.mag-spread-thumb');
      thumbs.forEach((t, i) => {
        if (i === index) t.classList.add('active');
        else t.classList.remove('active');
      });

      // 6. Banner siguiente folio
      const banner = document.getElementById('next-page-banner');
      const bannerTitle = document.getElementById('next-page-title');
      if (banner) {
        if (index < magazinePages.length - 1) {
          banner.style.display = 'flex';
          if (bannerTitle) bannerTitle.textContent = magazinePages[index + 1].title;
        } else {
          banner.style.display = 'none';
        }
      }

      // Scroll top de la columna de texto al cambiar de página
      if (contentCol) contentCol.scrollTop = 0;
    }

    if (animate) {
      if (imgEl) imgEl.classList.add('fade-out');
      if (capEl) capEl.classList.add('fade-out');
      if (contentCol) contentCol.classList.add('fade-out');

      setTimeout(() => {
        updateDOM();
        if (imgEl) imgEl.classList.remove('fade-out');
        if (capEl) capEl.classList.remove('fade-out');
        if (contentCol) contentCol.classList.remove('fade-out');
      }, 180);
    } else {
      updateDOM();
    }
  }

  // Navegación relativa (+1, -1)
  function changePage(delta) {
    const nextIdx = currentPageIndex + delta;
    if (nextIdx >= 0 && nextIdx < magazinePages.length) {
      renderPage(nextIdx, true);
    }
  }

  // Navegación absoluta a folio específico
  function goToPage(idx) {
    if (idx !== currentPageIndex && idx >= 0 && idx < magazinePages.length) {
      renderPage(idx, true);
    }
  }

  // Atajos de teclado (flechas ← y →)
  window.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === 'PageDown') {
      changePage(1);
    } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
      changePage(-1);
    }
  });

  // ─── CARGA INICIAL E HIDRATACIÓN DINÁMICA ───
  (function initMagazine() {
    try {
      const pathParts = window.location.pathname.split('/').filter(Boolean);
      const curId = pathParts[pathParts.length - 1] || 'draft_id';

      // SOLO buscar draft dinámico si es explícitamente la ruta de borrador o si existe una clave específica para este ID
      let raw = null;
      if (curId === 'draft' || curId === 'draft_id') {
        raw = localStorage.getItem(`tgp_magazine_${curId}`)
           || localStorage.getItem('tgp_magazine_draft')
           || sessionStorage.getItem('tgp_current_magazine')
           || localStorage.getItem('tgp_current_magazine');
      } else {
        // Para revistas publicadas, sólo leer si hay una versión guardada explícitamente para ese ID específico
        raw = localStorage.getItem(`tgp_magazine_${curId}`);
      }

      if (raw) {
        const art = JSON.parse(raw);
        if (art && art.titulo) {
          console.log('[TGP Magazine] Cargando edición dinámica:', art.titulo);

          // Página 1: Hero Principal
          const pages = [
            {
              folio: '01',
              tag: 'FOLIO I · SÍNTESIS COGNITIVA',
              title: art.titulo,
              subtitle: art.subtitulo || 'Edición Inmersiva TGP',
              excerpt: art.excerpt || '',
              body: art.body || '',
              imageUrl: art.heroUrl || '/magazine-hero-gobekli.jpg',
              imageCaption: art.heroCaption || art.subtitulo || '',
              imageCredit: art.heroCredit || 'TGP Vault · R2 Archive',
              date: art.date || new Date().toLocaleDateString('es-ES'),
              slug: art.slug || 'ensayo',
              readingTime: art.reading_time || '6 min'
            }
          ];

          // Páginas 2..N: Cada artefacto del slider se convierte en un folio editorial completo
          const slider = art.galeria?.slider;
          if (Array.isArray(slider) && slider.length > 0) {
            slider.forEach((item, idx) => {
              const folioNum = String(idx + 2).padStart(2, '0');
              const rawCaption = item.caption || `Artefacto Visual ${idx + 1}`;
              const captionParts = rawCaption.split(':');
              const subTitle = captionParts.length > 1 ? captionParts[0].trim() : `Análisis del Artefacto ${idx + 1}`;
              const desc = captionParts.length > 1 ? captionParts.slice(1).join(':').trim() : rawCaption;

              pages.push({
                folio: folioNum,
                tag: `FOLIO ${folioNum} · REGISTRO ARQUEOLÓGICO`,
                title: subTitle,
                subtitle: `Perspectiva material e iconográfica`,
                excerpt: desc,
                body: `Este registro fotográfico evidencia los patrones materiales preservados en la estratigrafía del yacimiento. La correlación entre la técnica constructiva y la narrativa iconográfica revela un dominio tecnológico avanzado en diálogo directo con las estructuras sagradas de la época.`,
                imageUrl: item.url,
                imageCaption: desc,
                imageCredit: item.credit || art.heroCredit || 'Colección TGP Vault',
                date: art.date || new Date().toLocaleDateString('es-ES'),
                slug: `${art.slug || 'ensayo'}/folio-${folioNum}`,
                readingTime: '3 min'
              });
            });
          }

          magazinePages = pages;

          // Reconstruir la tira de miniaturas
          const track = document.getElementById('spreads-track');
          if (track) {
            track.innerHTML = magazinePages.map((p, idx) => `
              <button type="button" class="mag-spread-thumb ${idx === 0 ? 'active' : ''}" onclick="goToPage(${idx})">
                <img src="${p.imageUrl}" alt="${p.title}" loading="lazy" />
                <div class="mag-spread-thumb__info">
                  <span class="mag-spread-thumb__num">FOLIO ${p.folio}</span>
                  <span class="mag-spread-thumb__title">${p.title}</span>
                </div>
              </button>
            `).join('');
          }

          if (art.theme) setTheme(art.theme);
          renderPage(0, false);
          return;
        }
      }
    } catch (e) {
      console.warn('[TGP Magazine] Error en hidratación:', e);
    }

    // Si no hay datos dinámicos en storage, usar las páginas estáticas correspondientes a esta edición
    magazinePages = defaultPages || [];
    renderPage(0, false);
  })();
</script>

</body>
</html>
