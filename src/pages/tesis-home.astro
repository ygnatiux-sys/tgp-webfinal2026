---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import TgpFilmRoll from '../components/TgpFilmRoll.astro';
---

<Layout title="Archivo de Tesis | The Great Puzzle Project">
	<!-- LENS GLOWS -->
	<div class="lens-glow -top-50 -left-50"></div>
	<div class="lens-glow -bottom-50 -right-50"></div>

	<Navbar />

	<main class="relative z-10 overflow-x-hidden pt-24 md:pt-32 pb-32">
		<!-- THESES HEADER CINEMÁTICO -->
		<PageHeader
			kicker="THE GREAT PUZZLE PROJECT · INVESTIGACIÓN COGNITIVA"
			title="Archivo de"
			accent="Tesis"
			logline="Arquitectura del sentido, antropología de la memoria y la prótesis técnica civilizatoria."
			primaryAction={{
				href: "/tesis",
				label: "Ver Fichas Técnicas & Créditos",
				icon: "→"
			}}
		/>

		<section id="tesis" class="relative px-6 md:px-16">
			<div class="flex flex-col gap-16 md:gap-20 max-w-6xl mx-auto">
				<a href="/tesis-01" class="thesis-card w-full bento-glass p-8 md:p-14 rounded-[2.5rem] group min-h-96 flex flex-col md:flex-row gap-12 items-center relative overflow-hidden">
					<div class="absolute -left-4 md:-left-8 top-1/2 -translate-y-1/2 text-[15rem] md:text-[22rem] font-bodoni italic opacity-0 blur-2xl group-hover:opacity-10 group-hover:blur-none transition-all duration-1000 select-none pointer-events-none text-vault-accent/20 number-reveal">01</div>
					<div class="text-7xl md:text-8xl font-bodoni italic text-vault-accent/20 group-hover:text-vault-accent/40 transition-colors z-10 relative">01</div>
					<div class="flex-1 z-10">
						<h3 class="t-display text-3xl sm:text-4xl md:text-5xl mb-4 uppercase transition-transform duration-500 group-hover:translate-x-2">
							I. El Sapiens <span class="italic font-light text-vault-accent">Arquitecto</span>
						</h3>
						<p class="font-inter font-light text-base md:text-lg leading-relaxed text-white/70 group-hover:text-white transition-colors max-w-2xl">
							No habitamos mundos materiales, sino relatos. La civilización es un mecanismo de defensa neurocognitivo proyectado a escala monumental.
						</p>
					</div>
				</a>

				<a href="/tesis-02" class="thesis-card w-full bento-glass p-8 md:p-14 rounded-[2.5rem] group min-h-96 flex flex-col md:flex-row gap-12 items-center relative overflow-hidden">
					<div class="absolute -left-4 md:-left-8 top-1/2 -translate-y-1/2 text-[15rem] md:text-[22rem] font-bodoni italic opacity-0 blur-2xl group-hover:opacity-10 group-hover:blur-none transition-all duration-1000 select-none pointer-events-none text-vault-accent/20 number-reveal">02</div>
					<div class="text-7xl md:text-8xl font-bodoni italic text-vault-accent/20 group-hover:text-vault-accent/40 transition-colors z-10 relative">02</div>
					<div class="flex-1 z-10">
						<h3 class="t-display text-3xl sm:text-4xl md:text-5xl mb-4 uppercase transition-transform duration-500 group-hover:translate-x-2">
							II. La Prótesis <span class="italic font-light text-vault-accent">Técnica</span>
						</h3>
						<p class="font-inter font-light text-base md:text-lg leading-relaxed text-white/70 group-hover:text-white transition-colors max-w-2xl">
							La tecnología no es externa; es la infraestructura donde nuestra mente se anida. El neocórtex es ahora compartido con la máquina.
						</p>
					</div>
				</a>

				<a href="/tesis-03" class="thesis-card w-full bento-glass p-8 md:p-14 rounded-[2.5rem] group min-h-96 flex flex-col md:flex-row gap-12 items-center relative overflow-hidden">
					<div class="absolute -left-4 md:-left-8 top-1/2 -translate-y-1/2 text-[15rem] md:text-[22rem] font-bodoni italic opacity-0 blur-2xl group-hover:opacity-10 group-hover:blur-none transition-all duration-1000 select-none pointer-events-none text-vault-accent/20 number-reveal">03</div>
					<div class="text-7xl md:text-8xl font-bodoni italic text-vault-accent/20 group-hover:text-vault-accent/40 transition-colors z-10 relative">03</div>
					<div class="flex-1 z-10">
						<h3 class="t-display text-3xl sm:text-4xl md:text-5xl mb-4 uppercase transition-transform duration-500 group-hover:translate-x-2">
							III. La Heurística <span class="italic font-light text-vault-accent">Alterna</span>
						</h3>
						<p class="font-inter font-light text-base md:text-lg leading-relaxed text-white/70 group-hover:text-white transition-colors max-w-2xl">
							Lo "alternativo" no es verdad oculta, sino una herramienta diagnóstica para cartografiar los procesos de exclusión y amnesia programada.
						</p>
					</div>
				</a>

				<a href="/tesis-04" class="thesis-card w-full bento-glass p-8 md:p-14 rounded-[2.5rem] group min-h-96 flex flex-col md:flex-row gap-12 items-center relative overflow-hidden">
					<div class="absolute -left-4 md:-left-8 top-1/2 -translate-y-1/2 text-[15rem] md:text-[22rem] font-bodoni italic opacity-0 blur-2xl group-hover:opacity-10 group-hover:blur-none transition-all duration-1000 select-none pointer-events-none text-vault-accent/20 number-reveal">04</div>
					<div class="text-7xl md:text-8xl font-bodoni italic text-vault-accent/20 group-hover:text-vault-accent/40 transition-colors z-10 relative">04</div>
					<div class="flex-1 z-10">
						<h3 class="t-display text-3xl sm:text-4xl md:text-5xl mb-4 uppercase transition-transform duration-500 group-hover:translate-x-2">
							IV. <span class="italic font-light text-vault-accent">Semiotización</span>
						</h3>
						<p class="font-inter font-light text-base md:text-lg leading-relaxed text-white/70 group-hover:text-white transition-colors max-w-2xl">
							El cerebro siempre sintetiza mitos. Ante la IA, el riesgo no es perder el sentido, sino convertirnos en espectadores del sentido generado por el proxy.
						</p>
					</div>
				</a>
			</div>
		</section>
		<style>
			.reveal-subtitle, .reveal-buttons {
				opacity: 1;
			}
			.number-reveal {
				transition: all 2s cubic-bezier(0.22, 1, 0.36, 1);
			}
		</style>
	</main>

	<!-- SHOWCASE IMAX: FILM ROLL CINEMÁTICO CON LAS ÚLTIMAS 10 PUBLICACIONES ALTERNATIVE -->
	<TgpFilmRoll 
		title="THE GREAT PUZZLE PROJECT" 
		subtitle="Una Nueva Historia se está gestando" 
		limit={10} 
	/>

	<Footer />
</Layout>
