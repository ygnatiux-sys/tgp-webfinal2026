---
// src/pages/archivo.astro
// Hemeroteca & Archivo Vivo — The Great Puzzle Project
// Integra Ediciones Magazine (Revistas Inmersivas 60/40 en su propio HTML) y Bóveda Cloudflare D1 / R2

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ArchivoHub from '../components/archivo/ArchivoHub.svelte';
import { getCollection } from 'astro:content';

let initialEnsayos: any[] = [];
let initialD1Items: any[] = [];

try {
  const ensayos = await getCollection('ensayos');
  if (Array.isArray(ensayos)) {
    initialEnsayos = ensayos.map((ensayo) => {
      const data = ensayo.data;
      const cover = data.gallery && data.gallery.length > 0 ? data.gallery[0] : undefined;
      const snippet = data.abstract || (ensayo.body ? ensayo.body.slice(0, 180).replace(/<[^>]*>?/gm, '').replace(/^[#\s*]+/gm, '') + '...' : '');

      return {
        id: ensayo.id,
        url: `/ensayos/${ensayo.id}`,
        title: data.title || 'Ensayo Histórico',
        volanta: data.volanta || data.powertype || 'Ensayo Editorial',
        description: snippet,
        category: data.category || 'Ensayo Editorial',
        imageUrl: cover || '/magazine-hero-gobekli.jpg',
        date: data.date ? new Date(data.date).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Fecha no registrada',
        tags: [data.category || 'ensayo', data.powertype || 'historia'].filter(Boolean),
        source: 'ensayo'
      };
    });
  }
} catch (e: any) {
  console.warn('[Archivo] Error cargando colección de ensayos:', e?.message);
}
---

<Layout title="Archivo & Magazines | The Great Puzzle Project">
  <!-- LENS GLOWS -->
  <div class="lens-glow -top-50 -left-50"></div>
  <div class="lens-glow -bottom-50 -right-50"></div>

  <Navbar />

  <main class="relative z-10 overflow-x-hidden pt-24 md:pt-32">
    <!-- HERO DE LA HEMEROTECA & ARCHIVO VIVO -->
    <section class="relative px-6 md:px-16 pb-20 max-w-7xl mx-auto text-center">
      <div class="w-full flex flex-col items-center mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-vault-accent/30 bg-vault-accent/5 backdrop-blur-md mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-vault-accent animate-pulse"></span>
          <span class="text-[10px] uppercase font-mono tracking-[0.35em] text-vault-accent font-medium">
            The Great Puzzle Project · Solapa Archivo & Hemeroteca
          </span>
        </div>

        <h1 class="font-bodoni text-6xl md:text-8xl lg:text-9xl leading-[0.9] font-extrabold tracking-tighter titulo-estilo-apple mb-8">
          Archivo & <span class="highlight-word italic font-light font-bodoni text-vault-accent">Magazines</span>
        </h1>

        <div class="w-24 h-px bg-highlight/30 mb-8"></div>

        <p class="font-inter font-light text-sm md:text-base tracking-[0.2em] uppercase text-fade-gradient max-w-2xl leading-relaxed">
          Ediciones inmersivas en pantalla completa, artefactos de la Bóveda D1 y testimonios arqueológicos.
        </p>
      </div>

      <!-- COMPONENTE SVELTE: ARCHIVO HUB (MAGAZINES + ENSAYOS + D1) -->
      <ArchivoHub client:load initialEnsayos={initialEnsayos} initialD1Items={initialD1Items} />
    </section>
  </main>

  <Footer />
</Layout>
