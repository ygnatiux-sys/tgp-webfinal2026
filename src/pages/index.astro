---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

---

<Layout title="The Great Puzzle Project | Landing">
	<!-- LENS GLOWS -->
	<div class="lens-glow -top-50 -left-50"></div>
	<div class="lens-glow -bottom-50 -right-50"></div>

	<Navbar />

	<main class="relative z-10 overflow-x-hidden pt-20">
		<!-- HERO SECTION -->
		<section id="hero" class="relative min-h-[calc(100vh-80px)] flex flex-col items-center justify-center text-center px-6 overflow-hidden">
			<div class="absolute -z-10 opacity-5 w-[70%] max-w-225 pointer-events-none">
				<img src="/puzzle.png" alt="" class="w-full h-auto grayscale blur-[2px]" />
			</div>

			<h1 class="font-bodoni text-5xl md:text-8xl font-bold leading-tight max-w-6xl mx-auto mb-12 titulo-estilo-apple tracking-tighter">
				Comprender por qué <span class="italic highlight-word">pensamos</span> lo que pensamos.
			</h1>
			<p class="font-inter font-thin text-[11px] md:text-sm tracking-[0.5em] uppercase text-fade-gradient max-w-3xl leading-[2.5] hero-subtitle">
				Una investigación sobre la arquitectura técnica del olvido y la gestión del sentido en la era digital.
			</p>
			
			<div class="mt-16 flex flex-col md:flex-row items-center justify-center gap-6 hero-subtitle reveal-buttons">
				<a href="/tesis-home" class="cta-editorial">Explorar el Archivo</a>
				<a href="/tgp-vault" class="cta-vault" title="Acceder a TGP-Vault">
					<span class="text-xs">◈</span>
					<span>TGP-Vault</span>
				</a>
				<a href="mailto:ygnatiux@gmail.com" class="cta-glass">Consultoría</a>
			</div>
			
			<div class="absolute bottom-12 left-1/2 -translate-x-1/2 animate-pulse opacity-40">
				<div class="w-px h-12 bg-border"></div>
			</div>
		</section>
	</main>

	<!-- FOOTER -->
	<Footer />

</Layout>
