---
// src/pages/tgp-app/index.astro
// TGP Scriptorium — Cartografía Epistémica & Ediciones (Dashboard Central)
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

interface ToolCard {
  title: string;
  desc: string;
  href?: string;
  badges?: { label: string; color: string }[];
  highlight?: boolean;
}

const TOOLS: ToolCard[] = [
  {
    title: 'Hemeroteca (Main Web)',
    desc: 'Gestionar ensayos, arquetipos y sitios arqueohistóricos.',
    href: '/archivo',
  },
  {
    title: 'Ediciones & Ebooks',
    desc: 'Gestionar publicaciones, dossiers y magazines.',
    href: '/magazine/gobekli-tepe',
  },
  {
    title: 'TGP-Vault / Atanor',
    desc: 'Centro de operaciones. Ingesta masiva, limpieza HTML y transmutación a D1/R2.',
    href: '/tgp-vault',
  },
  {
    title: 'TGP Alternative',
    desc: 'Gestionar ensayos, narrativas liminales y arquitectura visual.',
    href: '/historia-alternativa',
  },
  {
    title: 'Atelier de Imprenta & Loops Cinemáticos',
    desc: 'Forja limpia de Revistas Fotográficas (Flipbooks interactivos) y Loops continuos de 4 fotogramas para Remotion.',
    href: '/tgp-app/imprenta',
    badges: [
      { label: 'NUEVO', color: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40' },
      { label: 'ATELIER', color: 'bg-amber-500/20 text-amber-300 border-amber-500/40' }
    ],
    highlight: true,
  },
  {
    title: 'Laboratorio Visual (R2 + Cloud Run)',
    desc: 'Transformaciones con OpenCV/Cloud Run y subida a Cloudflare R2 con Google Picker integrado.',
    href: '/tgp-vault',
    badges: [{ label: 'ACTIVO', color: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40' }],
  },
  {
    title: 'TGP Scriptorium (Página Oficial)',
    desc: 'Análisis iconográfico con Gemini Vision, extracción desde Google Drive / Fotos y vista dedicada.',
    href: '/tgp-vault',
    badges: [{ label: 'MULTIMODAL', color: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40' }],
  },
  {
    title: 'Visor Forense Notion-Style',
    desc: 'Visor inmersivo 3 columnas de registros GAS. Hero carousel, pills de metadata, bloques Notion.',
    href: '/tgp-vault',
    badges: [{ label: 'NUEVO', color: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40' }],
  },
  {
    title: 'TGP Vision / Iconografía',
    desc: 'Análisis visual profundo, semiótica iconográfica e ingesta directa con Google Drive / Fotos.',
    href: '/tgp-vault',
    badges: [
      { label: 'MODAL RÁPIDO', color: 'bg-cyan-500/20 text-cyan-400 border-cyan-500/40' },
      { label: 'MULTIMODAL', color: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40' },
    ],
  },
];
---

<Layout title="TGP Scriptorium · Cartografía Epistémica & Ediciones">
  <!-- LENS GLOWS -->
  <div class="lens-glow -top-40 -left-40 opacity-40"></div>
  <div class="lens-glow -bottom-40 -right-40 opacity-30"></div>

  <Navbar />

  <main class="relative z-10 max-w-5xl mx-auto px-6 pt-32 pb-24">
    <!-- Header Epistémico -->
    <header class="text-center mb-14">
      <p class="text-[11px] uppercase tracking-[0.28em] text-neutral-400 font-medium mb-3">
        Cartografía Epistémica &amp; Ediciones
      </p>
      <h1 class="text-4xl md:text-5xl font-extrabold font-gloock tracking-tight text-white mb-4">
        TGP Scriptorium
      </h1>
      <div class="w-16 h-px bg-white/20 mx-auto"></div>
    </header>

    <!-- Grid de Herramientas -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-16">
      {TOOLS.map((tool) => (
        <a
          href={tool.href || '#'}
          class={`group relative p-6 rounded-2xl border transition-all duration-300 block backdrop-blur-md ${
            tool.highlight
              ? 'bg-amber-500/5 border-amber-500/30 hover:border-amber-400 hover:shadow-[0_0_35px_rgba(245,158,11,0.15)] ring-1 ring-amber-500/20'
              : 'bg-neutral-900/60 border-neutral-800/80 hover:border-neutral-600 hover:bg-neutral-900/90 shadow-lg'
          }`}
        >
          <div class="flex items-start justify-between gap-3 mb-2.5">
            <h2 class="text-lg md:text-xl font-literata font-semibold text-white group-hover:text-amber-200 transition-colors">
              {tool.title}
            </h2>
            {tool.badges && (
              <div class="flex items-center gap-1.5 shrink-0">
                {tool.badges.map((b) => (
                  <span class={`text-[9px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded-full border ${b.color}`}>
                    {b.label}
                  </span>
                ))}
              </div>
            )}
          </div>
          <p class="text-xs md:text-sm text-neutral-400 leading-relaxed font-light">
            {tool.desc}
          </p>

          <!-- Flecha de acceso sutil -->
          <div class="mt-4 flex items-center text-[11px] font-mono tracking-wider text-neutral-500 group-hover:text-amber-300 transition-colors">
            <span>Acceder</span>
            <span class="inline-block transition-transform duration-300 group-hover:translate-x-1.5 ml-1">→</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Pie de Seguridad Exclusivo -->
    <footer class="text-center pt-8 border-t border-neutral-800/60">
      <p class="text-[11px] font-mono text-neutral-500 tracking-wider">
        Acceso restringido — Autorizado exclusivamente para Xavier Benitez.
      </p>
    </footer>
  </main>

  <Footer />
</Layout>
