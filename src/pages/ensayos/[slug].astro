---
// src/pages/ensayos/[slug].astro
// Visor Editorial de Ensayos y Borradores — The Great Puzzle Project

import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ArticleKenBurnsModal from '../../components/ArticleKenBurnsModal';

export async function getStaticPaths() {
  const ensayos = await getCollection('ensayos', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });
  return ensayos.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { slug } = Astro.params;
const ensayos = await getCollection('ensayos');
const entry = Astro.props.entry || ensayos.find((e) => e.id === slug || e.data.slug === slug);

if (!entry || (import.meta.env.PROD && entry.data.draft)) {
  return Astro.redirect('/archivo');
}

const { Content } = await render(entry);
const data = entry.data;

// Formateador de fecha
function formatDate(dateStr?: string) {
  if (!dateStr) return 'Fecha no registrada';
  try {
    const d = new Date(dateStr);
    return new Intl.DateTimeFormat('es-ES', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(d);
  } catch {
    return dateStr;
  }
}

const formattedDate = formatDate(data.date);

// 1. Extraer imágenes explícitas de la galería
const rawGallery: string[] = data.gallery || [];

// 2. Extraer imágenes embebidas en el contenido si existen
const bodyImages: string[] = [];
if (entry.body) {
  const imgMatches = entry.body.matchAll(/<img[^>]+src=["']([^"']+)["']/g);
  for (const match of imgMatches) {
    if (match[1] && !bodyImages.includes(match[1])) {
      bodyImages.push(match[1]);
    }
  }
}

// 3. Fallback fotográfico temático de alta resolución para que todo artículo tenga registro visual
const defaultFallback = (entry.id === 'the-caterpillar' || data.slug === 'the-caterpillar')
  ? 'https://upload.wikimedia.org/wikipedia/commons/4/4e/Dusk_landscape_high_resolution.jpg'
  : (entry.id === 'la-biblioteca-de-alejandria' || data.slug === 'la-biblioteca-de-alejandria')
  ? 'https://upload.wikimedia.org/wikipedia/commons/thumb/d/d4/Ancient_Library_of_Alexandria.jpg/1280px-Ancient_Library_of_Alexandria.jpg'
  : '/magazine-hero-gobekli.jpg';

const allImages: string[] = Array.from(new Set([
  ...rawGallery,
  ...bodyImages,
  ...(rawGallery.length === 0 && bodyImages.length === 0 ? [defaultFallback] : [])
])).filter((url): url is string => Boolean(url));

const mainImage = allImages[0];
const secondaryImages = allImages.slice(1);
---

<Layout title={`${data.title} | The Great Puzzle Project`}>
  <div class="lens-glow -top-40 -left-40"></div>
  <div class="lens-glow top-1/2 -right-60"></div>
  <div class="lens-glow -bottom-50 left-1/4"></div>

  <Navbar />

  <main class="relative z-10 min-h-screen pt-28 md:pt-36 pb-32 px-6 md:px-12">
    <div class="max-w-6xl mx-auto mb-12 flex justify-between items-center">
      <a
        href="/archivo"
        class="cta-glass rounded-full! px-6! py-2.5! text-[10px]! uppercase tracking-widest group flex items-center gap-2"
      >
        <span class="group-hover:-translate-x-1 inline-block transition-transform">←</span>
        <span>Volver al Archivo</span>
      </a>

      <div class="flex items-center gap-3 text-[10px] font-mono tracking-widest text-vault-accent uppercase">
        {data.category && (
          <span class="px-3.5 py-1 rounded-full border border-vault-accent/30 bg-vault-accent/10">
            {data.category}
          </span>
        )}
        {data.powertype && (
          <span class="opacity-60 hidden sm:inline-block">
            ◈ {data.powertype}
          </span>
        )}
      </div>
    </div>

    <header class="max-w-4xl mx-auto text-center mb-16 space-y-6">
      {data.volanta && (
        <p class="text-[11px] md:text-xs uppercase tracking-[0.4em] text-vault-accent/80 font-mono font-medium">
          {data.volanta}
        </p>
      )}

      <h1 class="font-bodoni text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-bold leading-[1.05] tracking-tight titulo-estilo-apple">
        {data.title}
      </h1>

      <div class="flex items-center justify-center gap-6 pt-4 text-xs font-mono tracking-widest text-primary/50 uppercase">
        <span>{formattedDate}</span>
        <span class="opacity-30">•</span>
        <span class="text-vault-accent/80">The Great Puzzle Project</span>
      </div>
    </header>

    {mainImage && (
      <div class="max-w-6xl mx-auto mb-16">
        <div class="flex items-center justify-between mb-4 px-2">
          <div class="text-[10px] font-mono tracking-widest text-vault-accent uppercase flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-vault-accent animate-pulse"></span>
            <span>Registro Visual Arqueológico</span>
          </div>

          {allImages.length > 0 && (
            <ArticleKenBurnsModal
              client:load
              images={allImages}
              title={data.title}
              subtitle={data.category || 'Archivo Vivo'}
              buttonLabel="Abrir Visor Ken Burns (100dvh)"
            />
          )}
        </div>

        <div
          class="bento-glass rounded-[2.5rem] p-3 md:p-5 border border-white/10 shadow-2xl overflow-hidden group cursor-pointer relative"
          data-kenburns-index="0"
          title="Click para ver en Visor Cinemático Ken Burns (100dvh)"
        >
          <div class="relative w-full h-[55vh] md:h-[72vh] rounded-4xl overflow-hidden bg-black/40">
            <img
              src={mainImage}
              alt={data.title}
              class="w-full h-full object-cover ken-burns-cinematic"
            />
            <div class="absolute inset-0 bg-linear-to-t from-bg/90 via-transparent to-transparent pointer-events-none"></div>

            <div class="absolute bottom-6 left-6 z-20 flex items-center gap-2 bg-black/75 backdrop-blur-md px-4 py-2 rounded-full border border-vault-accent/40 text-[10px] font-mono tracking-widest uppercase text-vault-accent group-hover:bg-vault-accent group-hover:text-black transition-all shadow-lg">
              <span>◈ Click para expandir en Visor Ken Burns (100dvh)</span>
            </div>

            {allImages.length > 1 && (
              <div class="absolute bottom-6 right-6 z-20 flex items-center gap-2 bg-black/70 backdrop-blur-md px-4 py-2 rounded-full border border-white/10 text-[10px] font-mono tracking-widest uppercase text-white/80">
                <span>◈ {allImages.length} Registros Visuales</span>
              </div>
            )}
          </div>
        </div>

        {secondaryImages.length > 0 && (
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6">
            {secondaryImages.map((imgUrl, idx) => (
              <div
                class="bento-glass rounded-2xl overflow-hidden p-2 border border-white/5 h-32 md:h-40 group/sub cursor-pointer relative hover:border-vault-accent/50 transition-all"
                data-kenburns-index={idx + 1}
                title={`Ver registro ${idx + 2} en Visor Ken Burns`}
              >
                <img
                  src={imgUrl}
                  alt={`Registro ${idx + 2}`}
                  class="w-full h-full object-cover rounded-xl group-hover/sub:scale-105 transition-all duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-black/20 group-hover/sub:bg-transparent transition-colors rounded-xl pointer-events-none"></div>
              </div>
            ))}
          </div>
        )}
      </div>
    )}

    <article class="max-w-4xl mx-auto">
      {data.abstract && (
        <div class="mb-14 p-8 md:p-10 bento-glass rounded-3xl border-l-4 border-l-vault-accent border-white/5 max-w-[66ch] mx-auto shadow-lg">
          <p class="font-bodoni italic text-xl md:text-2xl text-highlight/90 leading-relaxed">
            "{data.abstract}"
          </p>
        </div>
      )}

      <div class="max-w-[66ch] mx-auto text-base md:text-lg text-primary/85 leading-[1.85] font-light space-y-8 tracking-wide font-inter ensayo-prose">
        <Content />
      </div>

      <div class="max-w-[66ch] mx-auto mt-20 pt-10 border-t border-white/10 flex flex-col sm:flex-row justify-between items-center gap-6 text-xs font-mono tracking-widest text-primary/40 uppercase">
        <span>The Great Puzzle Project · Archivo Vivo</span>
        <a href="/archivo" class="hover:text-vault-accent transition-colors flex items-center gap-2">
          <span>Explorar más borradores</span>
          <span>→</span>
        </a>
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<style is:global>
  .ensayo-prose h2,
  .ensayo-prose h3,
  .ensayo-prose h4 {
    font-family: 'Bodoni Moda', serif;
    color: #fdfbf7;
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    display: block;
  }

  .ensayo-prose h2 {
    font-size: 2rem;
  }

  .ensayo-prose h3 {
    font-size: 1.6rem;
    color: #e5e5e5;
  }

  .ensayo-prose h4 {
    font-size: 1.25rem;
    color: #9F8CAE;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-family: 'Inter', sans-serif;
  }

  .ensayo-prose p {
    margin-bottom: 1.75rem;
    color: rgba(213, 213, 213, 0.9);
    line-height: 1.85;
  }

  .ensayo-prose blockquote {
    border-left: 2px solid #9F8CAE;
    padding-left: 1.5rem;
    font-style: italic;
    color: rgba(253, 251, 247, 0.85);
    margin: 2rem 0;
  }

  .ensayo-prose ul,
  .ensayo-prose ol {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
    color: rgba(213, 213, 213, 0.85);
  }

  .ensayo-prose li {
    margin-bottom: 0.75rem;
  }

  .ensayo-prose strong {
    color: #fdfbf7;
    font-weight: 600;
  }

  .ensayo-prose a {
    color: #9F8CAE;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.3s ease;
  }

  .ensayo-prose a:hover {
    color: #ffffff;
  }

  .ensayo-prose img {
    cursor: pointer;
    transition: transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
  }

  .ensayo-prose img:hover {
    transform: scale(1.015);
    border-color: rgba(201, 169, 110, 0.6);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8), 0 0 20px rgba(201, 169, 110, 0.2);
  }

  /* Efecto Ken Burns milimétrico desde punto angular (zoom-out suave) */
  @keyframes ken-burns-zoom-out {
    0% {
      transform: scale(1.08) translate(1.2%, 1%);
    }
    50% {
      transform: scale(1.04) translate(-0.4%, -0.3%);
    }
    100% {
      transform: scale(1.0) translate(0, 0);
    }
  }

  .ken-burns-cinematic {
    transform-origin: 15% 15%;
    animation: ken-burns-zoom-out 20s cubic-bezier(0.25, 1, 0.5, 1) infinite alternate ease-in-out;
    will-change: transform;
  }
</style>
