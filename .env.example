# TGP-Vault — Variables de Entorno (Plantilla de Ejemplo)
# Webhook de Cloud Run para ingesta de contenido histórico
PUBLIC_IA_WEBHOOK_URL=https://your-cloud-run-service.run.app
PUBLIC_VAULT_WEBHOOK_URL=https://your-vault-service.run.app/vault-ingest
# Proxy de Wikimedia y extracción de entidades
PUBLIC_PROXY_URL=
